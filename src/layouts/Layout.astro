---
import Footer from "@/components/Footer.astro";
import "../styles/global.css";
import Header from "@/components/Header.astro";

interface Props {
    title?: string;
    description?: string;
}
const {
    title = "Jalsuri | Agua Purificada & Soluciones Corporativas",
    description = "Agua purificada de máxima calidad, procesamiento ozonizado y servicios de maquila corporativa para empresas.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/logo.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
    </head>
    <body>
        <Header solid />
        <slot />
        <Footer />
    </body>
</html>

<script>
    // Función para obtener y procesar la altura real actual
    function updateHeaderHeight() {
        const header = document.getElementById("main-header");

        if (header) {
            // .offsetHeight lee la altura exacta renderizada en pixeles (incluye padding y bordes)
            const currentHeight = header.offsetHeight;

            console.log(
                `Altura actual del header detectada por JS: ${currentHeight}px`,
            );

            // AQUÍ TU LÓGICA DE JAVASCRIPT:
            // Por ejemplo, puedes pasarle este dato a una función global,
            // emitir un evento personalizado o guardarlo temporalmente.
            document.dispatchEvent(
                new CustomEvent("header-resized", { detail: currentHeight }),
            );
        }
    }

    // 1. Ejecutar al cargar la página
    updateHeaderHeight();

    // 2. Ejecutar cada vez que el usuario cambie el tamaño de pantalla (Mobile <-> Desktop)
    window.addEventListener("resize", updateHeaderHeight);
</script>
