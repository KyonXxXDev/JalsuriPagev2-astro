---
import WhatsApp from "@/components/icons/WhatsApp.astro";
import Button from "@/components/general/Button";

const WA = "https://wa.me/51997673300";

const distritos = [
    "San Martín de Porres",
    "Independencia",
    "Los Olivos",
    "Comas",
    "Puente Piedra",
    "Carabayllo",
    "Villa El Salvador",
    "San Juan de Lurigancho",
];

const metodosPago = ["Yape", "Plin", "Tarjetas", "Efectivo"];
---

<section
    id="delivery"
    class="relative z-30 py-24 px-4 sm:px-8 lg:px-12 overflow-hidden"
>
    

    <div class="max-w-7xl mx-auto space-y-16 relative z-10">
        <div class="text-center space-y-4 max-w-3xl mx-auto flex flex-col items-center">
            <div class="inline-flex items-center gap-3">
                
                <span
                    class="text-secondary font-bold text-xs md:text-sm tracking-[0.2em] uppercase"
                >
                    Delivery y Contacto
                </span>
                <span class="w-8 h-0.5 bg-secondary"></span>
            </div>
            <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-text font-display tracking-tight leading-[1.1]"
            >
                ¿Llegamos a tu <span
                    class="text-transparent bg-clip-text bg-linear-to-r from-primary to-secondary"
                    >zona?</span
                >
            </h2>
            <p class="text-text/70 text-lg sm:text-xl font-medium leading-relaxed">
                Repartimos agua purificada a los principales distritos del
                norte y sur de Lima. Escríbenos para confirmar cobertura y coordinar tu entrega.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-stretch">
            <!-- Zonas de cobertura -->
            <div
                class="bg-white rounded-3xl border border-secondary/20 shadow-md p-8 sm:p-10 space-y-6 flex flex-col justify-between"
            >
                <div class="space-y-6">
                    <h3
                        class="text-xl font-extrabold font-display text-text"
                    >
                        Zonas de Cobertura
                    </h3>
                    <div class="flex flex-wrap gap-2.5">
                        {
                            distritos.map((d) => (
                                <span class="px-4 py-2 rounded-full bg-secondary/10 border border-secondary/20 text-text text-sm font-semibold hover:border-secondary transition-colors">
                                    {d}
                                </span>
                            ))
                        }
                    </div>
                    <p class="text-sm text-text/60">
                        *¿Tu distrito no aparece? Escríbenos: atendemos zonas
                        cercanas bajo pedido corporativo y programado.
                    </p>
                </div>

                <div class="pt-4 border-t border-secondary/10 space-y-6">
                    <div>
                        <h3
                            class="text-xl font-extrabold font-display text-text mb-3"
                        >
                            Horarios de Atención
                        </h3>
                        <ul class="text-sm text-text/70 space-y-1.5">
                            <li>
                                <strong class="text-text"
                                    >Lunes a Sábado:</strong
                                > 7:00 am – 8:00 pm
                            </li>
                            <li>
                                <strong class="text-text">Domingos:</strong> 8:00 am
                                – 2:00 pm
                            </li>
                        </ul>
                    </div>

                    <div>
                        <h3
                            class="text-xl font-extrabold font-display text-text mb-3"
                        >
                            Métodos de Pago
                        </h3>
                        <div class="flex flex-wrap gap-2.5">
                            {
                                metodosPago.map((m) => (
                                    <span class="px-4 py-2 rounded-xl bg-text text-white text-sm font-bold tracking-wide shadow-sm">
                                        {m}
                                    </span>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contacto rápido -->
            <div
                id="contacto"
                class="bg-linear-to-br from-primary via-primary to-secondary rounded-3xl p-8 sm:p-12 text-white flex flex-col justify-between gap-8 shadow-2xl shadow-primary/25 relative overflow-hidden"
            >
                <div
                    class="absolute -right-10 -bottom-10 w-60 h-60 bg-white/10 rounded-full blur-2xl pointer-events-none"
                >
                </div>

                <div class="space-y-4 relative z-10">
                    <span class="inline-block px-3.5 py-1 rounded-full bg-white/20 text-white text-xs font-bold uppercase tracking-wider">
                        Atención Inmediata
                    </span>
                    <h3 class="text-3xl font-extrabold font-display leading-tight">
                        Pedido Rápido & Cotizaciones
                    </h3>
                    <p class="text-white/90 text-base sm:text-lg leading-relaxed">
                        Te confirmamos cobertura, precios corporativos y horarios de entrega en minutos a través de WhatsApp.
                    </p>
                </div>

                <div class="flex flex-col gap-4 relative z-10">
                    <Button
                        text="Pedir por WhatsApp"
                        href={WA}
                        target="_blank"
                        variant="white"
                        size="lg"
                        className="w-full justify-center shadow-lg font-extrabold"
                    >
                        <WhatsApp class="size-5 text-black" />
                    </Button>
                    <Button
                        text="+51 997 673 300"
                        href="tel:+51997673300"
                        variant="outline"
                        size="lg"
                        className="w-full justify-center border-white/60 text-white hover:bg-white/15 hover:border-white hover:text-white"
                    >
                        <svg
                            class="w-5 h-5 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                            ></path>
                        </svg>
                    </Button>
                </div>
            </div>
        </div>
    </div>
</section>
