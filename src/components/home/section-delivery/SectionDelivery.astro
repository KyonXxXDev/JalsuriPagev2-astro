---
const WA = "https://wa.me/51997673300";

const distritos = [
    "San Martín de Porres",
    "Independencia",
    "Los Olivos",
    "Comas",
    "Puente Piedra",
    "Carabayllo",
    "Villa El Salvador",
    "San Juan de Lurigancho",
];

const metodosPago = ["Yape", "Plin", "Tarjetas", "Efectivo"];
---

<section
    id="delivery"
    class="relative z-30 bg-slate-50 py-24 px-6 md:px-16 overflow-hidden"
>
    <div
        class="absolute top-0 -left-32 w-96 h-96 bg-sky-200/40 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto space-y-14 relative z-10">
        <div class="text-center space-y-4 max-w-3xl mx-auto">
            <span
                class="text-sky-700 text-xs font-bold tracking-[0.3em] uppercase bg-sky-100 border border-sky-200 px-4 py-1.5 rounded-full inline-block"
            >
                Delivery y Contacto
            </span>
            <h2
                class="text-3xl sm:text-5xl font-extrabold text-slate-900 font-display tracking-tight leading-tight"
            >
                ¿Llegamos a tu <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary"
                    >zona?</span
                >
            </h2>
            <p class="text-slate-600 text-base sm:text-lg">
                Repartimos agua purificada a los principales distritos del
                norte y sur de Lima. Escríbenos para confirmar cobertura.
            </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-start">
            <!-- Zonas de cobertura -->
            <div
                class="bg-white rounded-3xl border border-slate-200/80 shadow-lg p-8 space-y-6"
            >
                <h3
                    class="text-xl font-extrabold font-display text-slate-900"
                >
                    Zonas de Cobertura
                </h3>
                <div class="flex flex-wrap gap-3">
                    {
                        distritos.map((d) => (
                            <span class="px-4 py-2 rounded-full bg-sky-50 border border-sky-100 text-sky-700 text-sm font-semibold">
                                {d}
                            </span>
                        ))
                    }
                </div>
                <p class="text-sm text-slate-500">
                    *¿Tu distrito no aparece? Escríbenos: atendemos zonas
                    cercanas bajo pedido.
                </p>

                <h3
                    class="text-xl font-extrabold font-display text-slate-900 pt-2"
                >
                    Horarios de Atención
                </h3>
                <ul class="text-sm text-slate-600 space-y-1">
                    <li>
                        <strong class="text-slate-800"
                            >Lunes a Sábado:</strong
                        > 7:00 am – 8:00 pm
                    </li>
                    <li>
                        <strong class="text-slate-800">Domingos:</strong> 8:00 am
                        – 2:00 pm
                    </li>
                </ul>

                <h3
                    class="text-xl font-extrabold font-display text-slate-900 pt-2"
                >
                    Métodos de Pago
                </h3>
                <div class="flex flex-wrap gap-3">
                    {
                        metodosPago.map((m) => (
                            <span class="px-4 py-2 rounded-xl bg-slate-900 text-white text-sm font-bold tracking-wide">
                                {m}
                            </span>
                        ))
                    }
                </div>
            </div>

            <!-- Contacto rápido -->
            <div
                id="contacto"
                class="bg-linear-to-br from-primary to-secondary rounded-3xl p-8 sm:p-10 text-white space-y-6 shadow-2xl shadow-sky-500/30"
            >
                <h3 class="text-2xl font-extrabold font-display">
                    Pedido Rápido
                </h3>
                <p class="text-sky-50/90 leading-relaxed">
                    Atención inmediata por WhatsApp. Te confirmamos cobertura,
                    precio y horario de entrega en minutos.
                </p>
                <div class="flex flex-col gap-4">
                    <a
                        href={WA}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-3 px-8 py-4 bg-white text-primary font-extrabold rounded-full hover:bg-sky-50 transition-colors shadow-lg"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a13.526 13.526 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                            ></path></svg
                        >
                        Pedir por WhatsApp
                    </a>
                    <a
                        href="tel:+51997673300"
                        class="inline-flex items-center justify-center gap-3 px-8 py-4 border-2 border-white/60 text-white font-bold rounded-full hover:bg-white/10 transition-colors"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                            ></path></svg
                        >
                        +51 997 673 300
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
