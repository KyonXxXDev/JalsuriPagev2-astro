---
import Button from "@/components/general/Button";

const WA = "https://wa.me/51997673300";

const pasos = [
    {
        n: "01",
        title: "Filtración Multietapa",
        desc: "Eliminamos sedimentos, partículas en suspensión y residuos mediante Microfiltración de 5 etapas.",
    },
    {
        n: "02",
        title: "Ósmosis Inversa",
        desc: "Reteniendo hasta el 99% de sólidos disueltos, sales, metales pesados y contaminantes invisibles.",
    },
    {
        n: "03",
        title: "Ozonización",
        desc: "Desinfección profunda con ozono gaseoso de alta concentración, sin dejar sabor ni residuos químicos.",
    },
    {
        n: "04",
        title: "Rayos Ultravioleta",
        desc: "Luz UV-C que inactiva virus y bacterias, garantizando un producto final 100% seguro.",
    },
];

const sellos = [
    {
        title: "Registro Sanitario VIGENTE",
        desc: "Autorizado por la DIGESA para consumo humano directo.",
    },
    {
        title: "Análisis Diarios",
        desc: "Laboratorio propio con control físico-químico y bacteriológico por lote.",
    },
    {
        title: "Estándares de Higiene",
        desc: "Planta certificada con protocolos HACCP y lavado automatizado de envases.",
    },
];
---

<section id="calidad" class="py-24 relative overflow-hidden bg-white">
    <div
        class="absolute top-1/3 -left-32 w-96 h-96 bg-secondary/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
        class="absolute bottom-1/3 -right-32 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <div
        class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 relative z-10 space-y-16"
    >
        <div
            class="text-center max-w-3xl mx-auto flex flex-col items-center gap-4"
        >
            <div class="inline-flex items-center gap-3">
                <span class="w-8 h-[2px] bg-secondary"></span>
                <span
                    class="text-secondary font-bold text-xs md:text-sm tracking-[0.2em] uppercase"
                >
                    Calidad & Certificaciones
                </span>
                <span class="w-8 h-[2px] bg-secondary"></span>
            </div>
            <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-text tracking-tight font-display leading-[1.1]"
            >
                Tu salud es nuestro <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary"
                    >compromiso</span
                >
            </h2>
            <p
                class="text-text/70 text-lg sm:text-xl font-medium leading-relaxed"
            >
                Cada lote de agua Jalsuri pasa por un proceso de purificación
                certificado antes de llegar a tu hogar u oficina.
            </p>
        </div>

        <!-- Pasos del proceso -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {
                pasos.map((paso) => (
                    <div class="relative bg-white rounded-3xl border border-secondary/20 p-6 hover:border-secondary hover:shadow-xl hover:shadow-primary/10 transition-all duration-300 shadow-sm">
                        <span class="text-4xl font-extrabold font-display text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary">
                            {paso.n}
                        </span>
                        <h3 class="mt-3 text-lg font-bold text-text font-display">
                            {paso.title}
                        </h3>
                        <p class="mt-2 text-sm text-text/70 leading-relaxed">
                            {paso.desc}
                        </p>
                    </div>
                ))
            }
        </div>

        <!-- Sellos / Garantías -->
        <div
            class="rounded-3xl bg-gradient-to-br from-text via-[#002B5B] to-text border border-secondary/25 p-8 sm:p-12 shadow-2xl relative overflow-hidden"
        >
            <div
                class="absolute -right-20 -top-20 w-64 h-64 bg-secondary/15 rounded-full blur-3xl pointer-events-none"
            >
            </div>
            <h3
                class="text-xl sm:text-2xl font-extrabold text-white font-display mb-8 text-center"
            >
                Certificaciones y Sellos de Garantía
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {
                    sellos.map((s) => (
                        <div class="flex items-start gap-4">
                            <span class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-secondary/20 text-secondary border border-secondary/30">
                                <svg
                                    class="size-5"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M5 13l4 4L19 7"
                                    />
                                </svg>
                            </span>
                            <div>
                                <h4 class="text-white font-bold">{s.title}</h4>
                                <p class="text-white/70 text-sm mt-1">
                                    {s.desc}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div
                class="mt-10 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 relative z-10"
            >
                <p class="text-white/80 text-sm font-medium text-center sm:text-left">
                    ¿Requieres documentación técnica o análisis microbiológicos para tu empresa?
                </p>
                <Button
                    text="Ver Ficha Técnica"
                    href="/ficha-tecnica"
                    variant="secondary"
                    size="sm"
                    className="shrink-0"
                />
            </div>
        </div>
    </div>
</section>
