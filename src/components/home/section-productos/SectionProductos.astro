---
import imgBidon from "@/assets/img/bidon.webp";
import imgBotellas from "@/assets/img/produc-y-element-5-1024x867.webp";
import imgPorPortada from "@/assets/img/PORTADA-WEB-JALSURI-BIDON-8.5-LITROS_2.webp";
import imgElement1 from "@/assets/img/produc-y-element-1-1024x867.webp";
import imgElement9 from "@/assets/img/produc-y-element-9-1024x867.webp";
import Button from "@/components/general/Button";
import WhatsApp from "@/components/icons/WhatsApp.astro";

const WA = "https://wa.me/51997673300";

const presentaciones = [
    {
        size: "500 ml",
        name: "Botella Personal",
        desc: "Ideal para llevar, gimnasios, colegios y consumo rápido fuera de casa.",
        tag: "Diaria",
        img: imgBotellas,
    },
    {
        size: "625 ml",
        name: "Botella Clásica",
        desc: "El formato clásico para escritorios, reuniones y tu día laboral.",
        tag: "Oficina",
        img: imgElement1,
    },
    {
        size: "1 Litro",
        name: "Botella Familiar",
        desc: "Mayor rendimiento para compartir en casa o en trayectos largos.",
        tag: "Familiar",
        img: imgElement9,
    },
];

const bidonesCano = [
    {
        size: "7 Litros",
        desc: "Práctico para mesas, reuniones y espacios reducidos. No requiere dispensador.",
        img: imgPorPortada,
    },
    {
        size: "10 Litros",
        desc: "Mayor capacidad para oficinas pequeñas y eventos de media jornada.",
        img: imgBidon,
    },
];
---

<section
    id="productos"
    class="relative z-30 py-24 px-4 sm:px-8 lg:px-12 overflow-hidden"
>
    <!-- Luces ambientales -->
    <div
        class="absolute top-0 -right-20 w-96 h-96 z-20 bg-secondary/15 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
        class="absolute bottom-0 -left-32 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto space-y-16 relative z-10">
        <!-- Cabecera -->
        <div class="text-center space-y-4 max-w-3xl mx-auto flex flex-col items-center">
            <div class="inline-flex items-center gap-3">
                <span class="w-8 h-[2px] bg-secondary"></span>
                <span
                    class="text-secondary font-bold text-xs md:text-sm tracking-[0.2em] uppercase"
                >
                    Catálogo Completo
                </span>
                <span class="w-8 h-[2px] bg-secondary"></span>
            </div>
            <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-text font-display tracking-tight leading-[1.1]"
            >
                Productos y <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary"
                    >Presentaciones</span
                >
            </h2>
            <p class="text-text/70 text-lg sm:text-xl font-medium leading-relaxed">
                Elige el formato perfecto para tu hogar, oficina o evento.
                Todas nuestras presentaciones llevan la pureza Jalsuri.
            </p>
        </div>

        <!-- Presentaciones personales -->
        <div class="space-y-8">
            <div class="flex items-center gap-3 border-l-4 border-secondary pl-4">
                <h3 class="text-2xl font-bold font-display text-text">
                    Presentaciones Personales
                </h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {
                    presentaciones.map((p) => (
                        <article class="group bg-white p-6 rounded-3xl border border-secondary/20 shadow-md hover:border-secondary hover:shadow-xl hover:shadow-primary/10 transition-all duration-300 flex flex-col justify-between">
                            <div>
                                <div class="relative overflow-hidden aspect-square bg-gradient-to-b from-sky-50/80 to-white rounded-2xl p-4 flex items-center justify-center border border-secondary/10">
                                    <img
                                        src={p.img.src}
                                        alt={`${p.name} ${p.size}`}
                                        loading="lazy"
                                        decoding="async"
                                        class="w-full h-full object-contain transition-transform duration-700 ease-out group-hover:scale-105"
                                    />
                                    <span class="absolute top-3 right-3 bg-secondary text-background text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
                                        {p.tag}
                                    </span>
                                </div>
                                <div class="pt-6 space-y-2">
                                    <span class="text-primary font-extrabold text-2xl font-display">
                                        {p.size}
                                    </span>
                                    <h4 class="text-xl font-bold text-text font-display group-hover:text-primary transition-colors">
                                        {p.name}
                                    </h4>
                                    <p class="text-xs sm:text-sm text-text/70 leading-relaxed">
                                        {p.desc}
                                    </p>
                                </div>
                            </div>
                            <div class="pt-6 border-t border-secondary/10 mt-6 flex items-center">
                                <Button
                                    text="Pedir Ahora"
                                    href={`${WA}?text=Hola,%20deseo%20informaci%C3%B3n%20sobre%20la%20presentaci%C3%B3n%20de%20${p.size}`}
                                    target="_blank"
                                    variant="primary"
                                    size="sm"
                                    className="w-full justify-center"
                                >
                                    <WhatsApp class="size-3.5" />
                                </Button>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>

        <!-- Bidones con caño -->
        <div class="space-y-8">
            <div class="flex items-center gap-3 border-l-4 border-secondary pl-4">
                <h3 class="text-2xl font-bold font-display text-text">
                    Bidones con Caño — Uso Directo
                </h3>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {
                    bidonesCano.map((b) => (
                        <article class="group bg-white p-6 rounded-3xl border border-secondary/20 shadow-md hover:border-secondary hover:shadow-xl hover:shadow-primary/10 transition-all duration-300 flex flex-col sm:flex-row gap-6 items-center">
                            <div class="w-40 h-40 shrink-0 bg-gradient-to-b from-sky-50/80 to-white rounded-2xl p-4 flex items-center justify-center border border-secondary/10">
                                <img
                                    src={b.img.src}
                                    alt={`Bidón Jalsuri con caño de ${b.size}`}
                                    loading="lazy"
                                    decoding="async"
                                    class="w-full h-full object-contain transition-transform duration-700 group-hover:scale-105"
                                />
                            </div>
                            <div class="space-y-3 text-center sm:text-left flex-1">
                                <span class="text-primary font-extrabold text-2xl font-display">
                                    {b.size}
                                </span>
                                <p class="text-sm text-text/70 leading-relaxed">
                                    {b.desc}
                                </p>
                                <div class="pt-2">
                                    <Button
                                        text="Consultar Precio"
                                        href={`${WA}?text=Hola,%20deseo%20informaci%C3%B3n%20sobre%20el%20bid%C3%B3n%20de%20${b.size.replace(" ", "%20")}%20con%20ca%C3%B1o`}
                                        target="_blank"
                                        variant="primary"
                                        size="sm"
                                        className="w-full sm:w-auto"
                                    >
                                        <WhatsApp class="size-3.5" />
                                    </Button>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </div>
</section>
