---
import imgKey from '@/assets/logo.webp'
import Button from '../../general/Button';
import { compromisoText } from './text';
import ClientsSlider from '@/components/ClientsSlider';
---

<section
    id="compromiso"
    class="absolute top-20 w-full h-screen overflow-hidden opacity-0 -z-10"
>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
        <div
            class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center"
        >
            <picture class="text-center col-span-1 lg:col-span-12">
                <img
                    src={imgKey.src}
                    alt="LOGO EMPRESA"
                    class="mx-auto w-48 h-auto opacity-90"
                />
            </picture>

            <!-- Columna Izquierda: Impacto Visual Directo -->
            <div class="lg:col-span-6 flex flex-col gap-6">
                <div class="inline-flex items-center gap-3">
                    <span class="w-8 h-[2px] bg-secondary"></span>
                    <span
                        class="text-secondary font-bold text-xs md:text-sm tracking-[0.2em] uppercase"
                    >
                        Para tu equipo
                    </span>
                </div>

                <h2
                    class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-text font-display leading-[1.1] tracking-tight"
                >
                    Soluciones que <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary"
                        >fluyen</span
                    > con tu ritmo laboral.
                </h2>

                <p
                    class="text-text/70 text-lg sm:text-xl font-medium leading-relaxed"
                >
                    Más que agua pura para oficinas y clínicas: <strong class="text-text">brindamos tranquilidad total</strong> a tu espacio de trabajo.
                </p>
            </div>

            <!-- Columna Derecha: Puntos clave limpios de estilo editorial -->
            <div
                class="lg:col-span-6 lg:col-start-7 flex flex-col gap-6 text-text/80"
            >
                <!-- Lista editorial sin tarjetas -->
                <ul class="flex flex-col gap-5 border-l-2 border-secondary/20 pl-6">
                    <li class="flex flex-col gap-1">
                        <span class="text-xs font-bold uppercase tracking-wider text-primary">01 / Pureza</span>
                        <p class="text-text/80 text-base leading-snug">
                            Agua 100% ozonizada y segura para acompañar cada jornada con los estándares más altos de calidad.
                        </p>
                    </li>
                    <li class="flex flex-col gap-1">
                        <span class="text-xs font-bold uppercase tracking-wider text-primary">02 / Sostenibilidad</span>
                        <p class="text-text/80 text-base leading-snug">
                            Bidones y dispensadores ergonómicos diseñados para ofrecer eficiencia con un menor impacto ambiental.
                        </p>
                    </li>
                </ul>

                <!-- Llamada a la Acción (Botón Limpio) -->
                <div class="pt-2">
                    <Button
                        client:load
                        type="button"
                        variant="primary"
                        text={compromisoText.cta.text}
                        href={compromisoText.cta.href}
                        className="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-3.5 bg-primary text-background font-bold text-xs sm:text-sm uppercase tracking-wider rounded-full hover:bg-secondary hover:shadow-lg hover:-translate-y-1 transition-all duration-300 shadow-md"
                    />
                </div>
            </div>
        </div>
    </div>
    <section id="clientes">
		<ClientsSlider client:load />
	</section>
</section>