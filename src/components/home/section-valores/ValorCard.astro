---
import Reload from '@/components/icons/Reload.astro';
import { ValorCardProps } from '@/components/types';


type Props = ValorCardProps;

const {
    title,
    description,
    badge,
    icon: Icon,
    backTitle,
    backDescription,
    features = [],
    ctaText = "Saber más",
    ctaLink = "#contacto",
} = Astro.props;
---

<div
    class="valor-card group [-webkit-tap-highlight-color:transparent]"
    data-flip-card
>
    <div class="valor-card__inner">
        <!-- ================= FRENTE DE LA TARJETA ================= -->
        <section class="valor-card__face valor-card__front">
            <!-- Arte y Burbujas en Segundo Plano -->
            <div class="valor-card__bg-layer" aria-hidden="true">
                <div class="valor-card__bubble b1"></div>
                <div class="valor-card__bubble b2"></div>
                <div class="valor-card__bubble b3"></div>
                <div class="valor-card__bubble b4"></div>

                <!-- Marca de Agua / Gota de Agua Grande -->
                <svg
                    class="valor-card__watermark"
                    viewBox="0 0 200 200"
                    fill="currentColor"
                >
                    <path
                        d="M100 12C83 42 43 82 43 119a57 57 0 00114 0c0-37-40-77-57-107z"
                    ></path>
                </svg>

                <!-- Silueta de Bidón Jalsuri en Segundo Plano -->
                <svg
                    class="valor-card__jug-bg"
                    viewBox="0 0 100 200"
                    fill="currentColor"
                >
                    <rect x="35" y="15" width="30" height="12" rx="3"></rect>
                    <rect x="20" y="32" width="60" height="140" rx="16"></rect>
                    <path
                        d="M20 60 H80 M20 90 H80 M20 120 H80 M20 150 H80"
                        stroke="white"
                        stroke-width="2"
                        opacity="0.15"></path>
                    <circle
                        cx="50"
                        cy="105"
                        r="16"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        opacity="0.3"></circle>
                </svg>
            </div>

            <!-- Botón de Giro Interactivo (Móvil) -->
            <button
                type="button"
                class="valor-card__flip"
                data-flip-button
                aria-label="Ver más información"
                aria-pressed="false"
            >
                <Reload class="size-5" />
            </button>

            <!-- Contenido Frontal Principal -->
            <div class="valor-card__front-content">
                <span class="valor-card__eyebrow">
                    AGUA PURIFICADA JALSURI
                </span>

                <div class="valor-card__icon">
                    {Icon && <Icon class="size-14 text-white" />}
                </div>

                <h3 class="valor-card__title">{title}</h3>

                <p class="valor-card__description">
                    {description}
                </p>
            </div>

            <!-- Footer del Frente -->
            <div class="valor-card__front-footer">
                <span class="valor-card__badge">
                    <span class="valor-card__status-dot"></span>
                    {badge}
                </span>

                <span class="valor-card__hint">
                    Toca para descubrir
                    <span aria-hidden="true"> ↗</span>
                </span>
            </div>
        </section>

        <!-- ================= REVERSO DE LA TARJETA ================= -->
        <section
            class="valor-card__face valor-card__back"
            aria-hidden="true"
            inert
        >
            <!-- Arte y Burbujas en Segundo Plano (Oscuro) -->
            <div class="valor-card__bg-layer" aria-hidden="true">
                <div class="valor-card__back-glow"></div>
                <div class="valor-card__bubble b1 b-dark"></div>
                <div class="valor-card__bubble b2 b-dark"></div>
                <div class="valor-card__bubble b3 b-dark"></div>

                <!-- Ilustración de Bidón Translúcido de Fondo -->
                <svg
                    class="valor-card__jug-bg-back"
                    viewBox="0 0 100 200"
                    fill="currentColor"
                >
                    <rect x="35" y="15" width="30" height="12" rx="3"></rect>
                    <rect x="18" y="32" width="64" height="145" rx="18"></rect>
                    <circle
                        cx="50"
                        cy="105"
                        r="18"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        opacity="0.4"></circle>
                </svg>
            </div>

            <!-- Botón de Regreso -->
            <button
                type="button"
                class="valor-card__flip valor-card__flip--back"
                data-flip-button
                aria-label="Volver al frente"
                aria-pressed="true"
            >
                <Reload class="size-5" />
            </button>

            <!-- Contenido del Reverso -->
            <div class="valor-card__back-content">
                <span class="valor-card__eyebrow valor-card__eyebrow--back">
                    NUESTRO COMPROMISO
                </span>

                <h3 class="valor-card__back-title">
                    {backTitle || title}
                </h3>

                <p class="valor-card__back-description">
                    {backDescription || description}
                </p>

                {
                    features.length > 0 && (
                        <ul class="valor-card__features">
                            {features.map((item) => (
                                <li>
                                    <span
                                        class="valor-card__check"
                                        aria-hidden="true"
                                    >
                                        ✓
                                    </span>
                                    <span>{item}</span>
                                </li>
                            ))}
                        </ul>
                    )
                }
            </div>

            <!-- Footer del Reverso -->
            <div class="valor-card__back-footer">
                <a class="valor-card__cta" href={ctaLink}>
                    {ctaText}
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </section>
    </div>
</div>

<style>
    .valor-card {
        --jalsuri-blue: var(--color-primary, #0084ff);
        --jalsuri-cyan: var(--color-secondary, #00c2ff);
        --jalsuri-deep: var(--color-ternary, #004080);
        --jalsuri-ink: var(--color-text, #0b3c73);
        --jalsuri-bg: var(--color-background, #ffffff);

        position: relative;
        width: 100%;
        height: 430px;
        perspective: 1200px;
        -webkit-tap-highlight-color: transparent;
        transition: transform 300ms ease;
    }

    /* Efecto hover flotante general en desktop */
    @media (hover: hover) and (pointer: fine) {
        .valor-card:hover {
            transform: translateY(-8px);
        }
        /* Giro automático al pasar el cursor en computadoras */
        .valor-card:hover .valor-card__inner {
            transform: rotateY(180deg);
        }
    }

    .valor-card__inner {
        position: relative;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        transition: transform 650ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }

    .valor-card.is-flipped .valor-card__inner {
        transform: rotateY(180deg);
    }

    .valor-card__face {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        overflow: hidden;
        padding: 28px;
        border-radius: 28px;
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
        isolation: isolate;
    }

    .valor-card__bg-layer {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
    }

    @keyframes bubbleRise {
        0% {
            transform: translateY(-500px) scale(0.6);
            opacity: 0;
            /* Forma inicial */
            border-radius: 51% 49% 48% 52% / 62% 44% 56% 38%;
        }
        20% {
            opacity: 0.7;
            /* La forma cambia orgánicamente */
            border-radius: 40% 60% 48% 52% / 60% 30% 70% 40%;
        }

        40% {
            opacity: 0.7;
            /* La forma cambia orgánicamente */
            border-radius: 40% 60% 48% 52% / 60% 30% 70% 40%;
        }

        80% {
            transform: scale(1.2);
            opacity: 0.7;
            border-radius: 60% 40% 50% 50% / 40% 60% 40% 60%;
        }
        100% {
            transform: translateY(0) scale(1.2);
            opacity: 0;
            border-radius: 51% 49% 48% 52% / 62% 44% 56% 38%;
        }
    }

    /* --- ESTILOS DE LA GOTA --- */
    .valor-card__bubble {
        position: absolute;
        bottom: -100px; /* Empezamos más abajo para que no se vea al inicio */

        /* 1. Forma Orgánica (No redonda) */
        /* Usamos border-radius complejos para dar forma de ameba/agua */
        border-radius: 51% 49% 48% 52% / 62% 44% 56% 38%;

        /* 2. Color base y Transparencia */
        background: var(--jalsuri-cyan);

        /* 3. Efecto Glassmorphism (Cristal) */
        /* Esto hace que lo que está detrás de la gota se desenfoque ligeramente */
        backdrop-filter: blur(2px);
        -webkit-backdrop-filter: blur(2px);

        /* 4. Profundidad con Sombras Múltiples (La clave del realismo) */
        box-shadow: 
        /* Sombra interior para dar volumen */
            inset 10px 10px 15px -10px rgba(255, 255, 255, 0.8),
            /* Sombra interior opuesta para oscuridad */ inset -10px -10px
                15px -10px rgba(0, 0, 0, 0.5),
            /* Brillo exterior suave (Cian) */ 0 0 20px 2px
                rgba(0, 238, 255, 0.3);

        /* Un borde muy fino para definir la silueta */
        border: 1px solid rgba(255, 255, 255, 0.1);

        /* Animación */
        animation: bubbleRise ease-in infinite;
    }

    /* 5. Destellos de luz con Pseudo-elementos (::before y ::after) */
    /* Estos crean los puntos blancos brillantes de la refracción */

    /* Destello principal arriba a la izquierda */
    .valor-card__bubble::before {
        content: "";
        position: absolute;
        top: 15%;
        left: 15%;
        width: 25%;
        height: 25%;
        background: rgba(255, 255, 255, 0.9);
        border-radius: 100%;
        filter: blur(1px); /* Suaviza el brillo */
    }

    /* Destello secundario alargado abajo a la derecha */
    .valor-card__bubble::after {
        content: "";
        position: absolute;
        bottom: 10%;
        right: 15%;
        width: 20%;
        height: 40%;
        background: rgba(255, 255, 255, 0.3);
        border-radius: 100%;
        filter: blur(2px);
        transform: rotate(-30deg);
    }

    .valor-card__bubble.b1 {
        left: 12%;
        width: 20px;
        height: 20px;
        opacity: 0.4;
        animation-duration: 4s;
        animation-delay: 0s;
    }
    .valor-card__bubble.b2 {
        left: 38%;
        width: 18px;
        height: 18px;
        opacity: 0.25;
        animation-duration: 6s;
        animation-delay: 1.5s;
    }
    .valor-card__bubble.b3 {
        left: 68%;
        width: 15px;
        height: 15px;
        opacity: 0.5;
        animation-duration: 3.5s;
        animation-delay: 0.8s;
    }
    .valor-card__bubble.b4 {
        left: 85%;
        width: 14px;
        height: 14px;
        opacity: 0.3;
        animation-duration: 5s;
        animation-delay: 2.2s;
    }

    .valor-card__bubble.b-dark {
        background: var(--jalsuri-cyan);
        opacity: 0.3;
    }

    .valor-card__front {
        color: var(--jalsuri-ink);
        background:
            radial-gradient(
                circle at 90% 12%,
                rgb(0 194 255 / 12%),
                transparent 32%
            ),
            linear-gradient(150deg, var(--jalsuri-bg) 25%, #f0faff 100%);
        border: 1px solid rgb(0 132 255 / 20%);
        box-shadow:
            0 12px 35px rgb(0 64 128 / 8%),
            inset 0 0 0 1px rgb(255 255 255 / 90%);
    }

    .valor-card__watermark {
        position: absolute;
        right: -25px;
        bottom: 20px;
        width: 160px;
        color: rgb(0 132 255 / 5%);
        transform: rotate(15deg);
    }

    .valor-card__jug-bg {
        position: absolute;
        left: -20px;
        bottom: -30px;
        width: 140px;
        color: rgb(0 194 255 / 8%);
        transform: rotate(-10deg);
    }

    .valor-card__back {
        color: white;
        background:
            radial-gradient(
                circle at 100% 0%,
                rgb(0 194 255 / 18%),
                transparent 36%
            ),
            linear-gradient(
                145deg,
                var(--jalsuri-ink),
                #003365 58%,
                var(--jalsuri-deep)
            );
        border: 1px solid rgb(0 194 255 / 30%);
        box-shadow: 0 18px 38px rgb(0 64 128 / 20%);
        transform: rotateY(180deg);
    }

    .valor-card__back-glow {
        position: absolute;
        right: -60px;
        bottom: -90px;
        width: 240px;
        height: 220px;
        background: rgb(0 132 255 / 24%);
        border-radius: 50%;
        filter: blur(55px);
    }

    .valor-card__jug-bg-back {
        position: absolute;
        right: -10px;
        bottom: 40px;
        width: 130px;
        color: rgb(255 255 255 / 5%);
        transform: rotate(12deg);
    }

    .valor-card__signature {
        position: absolute;
        left: 20px;
        bottom: 15px;
        width: 180px;
        color: rgb(0 194 255 / 20%);
    }

    .valor-card__flip {
        position: absolute;
        z-index: 3;
        top: 18px;
        right: 18px;
        display: grid;
        width: 42px;
        height: 42px;
        place-items: center;
        color: var(--jalsuri-blue);
        cursor: pointer;
        background: rgb(255 255 255 / 85%);
        border: 1px solid rgb(0 132 255 / 18%);
        border-radius: 50%;
        transition:
            color 200ms ease,
            background 200ms ease,
            transform 200ms ease;
    }

    .valor-card__flip:hover {
        color: white;
        background: var(--jalsuri-blue);
        transform: rotate(-35deg);
    }

    .valor-card__flip--back {
        color: #b8efff;
        background: rgb(255 255 255 / 8%);
        border-color: rgb(255 255 255 / 15%);
    }

    .valor-card__flip--back:hover {
        color: var(--jalsuri-ink);
        background: white;
    }

    .valor-card__front-content,
    .valor-card__back-content {
        position: relative;
        z-index: 1;
    }

    .valor-card__front-content {
        display: flex;
        flex: 1;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .valor-card__eyebrow {
        margin-bottom: 18px;
        color: var(--jalsuri-blue);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.16em;
    }

    .valor-card__icon {
        display: grid;
        width: 90px;
        height: 90px;
        margin-bottom: 18px;
        color: white;
        place-items: center;
        background: linear-gradient(
            140deg,
            var(--jalsuri-cyan),
            var(--jalsuri-blue) 65%,
            var(--jalsuri-deep)
        );
        border: 1px solid rgb(255 255 255 / 75%);
        border-radius: 26px;
        box-shadow:
            0 12px 28px rgb(0 132 255 / 22%),
            inset 0 1px 0 rgb(255 255 255 / 35%);
        transition: transform 300ms ease;
    }

    .valor-card__title {
        margin: 0;
        color: var(--jalsuri-ink);
        font-size: clamp(20px, 2vw, 25px);
        font-weight: 700;
        line-height: 1.2;
        letter-spacing: -0.025em;
    }

    .valor-card__description {
        max-width: 280px;
        margin: 10px 0 0;
        color: #476785;
        font-size: 13px;
        line-height: 1.6;
    }

    .valor-card__front-footer {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        padding-top: 16px;
        border-top: 1px solid rgb(0 132 255 / 12%);
    }

    .valor-card__badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        color: var(--jalsuri-deep);
        font-size: 11px;
        font-weight: 700;
        background: rgb(0 132 255 / 7%);
        border: 1px solid rgb(0 132 255 / 12%);
        border-radius: 999px;
    }

    .valor-card__status-dot {
        width: 7px;
        height: 7px;
        background: var(--jalsuri-cyan);
        border-radius: 50%;
        box-shadow: 0 0 0 3px rgb(0 194 255 / 13%);
    }

    .valor-card__hint {
        color: #6b849b;
        font-size: 11px;
    }

    .valor-card__eyebrow--back {
        display: block;
        padding-right: 38px;
        color: #71e1ff;
    }

    .valor-card__back-title {
        margin: 0 0 10px;
        color: white;
        font-size: clamp(22px, 2vw, 26px);
        font-weight: 700;
        line-height: 1.2;
    }

    .valor-card__back-description {
        margin: 0;
        color: #d0e5f7;
        font-size: 13px;
        line-height: 1.6;
    }

    .valor-card__features {
        display: grid;
        gap: 10px;
        margin: 18px 0 0;
        padding: 0;
        list-style: none;
    }

    .valor-card__features li {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #f0f8ff;
        font-size: 12px;
    }

    .valor-card__check {
        display: grid;
        flex: 0 0 20px;
        width: 20px;
        height: 20px;
        color: #75e7ff;
        place-items: center;
        background: rgb(0 194 255 / 15%);
        border: 1px solid rgb(0 194 255 / 35%);
        border-radius: 50%;
        font-size: 11px;
        font-weight: bold;
    }

    .valor-card__back-footer {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-top: 16px;
        border-top: 1px solid rgb(255 255 255 / 15%);
    }

    .valor-card__cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 10px 18px;
        color: #003365;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        background: var(--jalsuri-cyan);
        border-radius: 999px;
        transition:
            background 200ms ease,
            transform 200ms ease,
            box-shadow 200ms ease;
    }

    .valor-card__cta:hover {
        background: white;
        box-shadow: 0 5px 20px rgb(0 194 255 / 25%);
        transform: translateY(-2px);
    }

    .valor-card__brand-note {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        color: #b8efff;
        font-size: 14px;
        font-weight: 700;
    }

    .valor-card__brand-note span {
        color: #d0e5f7;
        font-size: 9px;
        font-weight: 400;
    }

    @media (hover: hover) and (pointer: fine) {
        .valor-card:hover .valor-card__icon {
            transform: translateY(-3px) scale(1.03);
        }
    }
</style>

<script>
    document
        .querySelectorAll<HTMLElement>("[data-flip-card]")
        .forEach((card) => {
            if (card.dataset.flipInitialized === "true") return;
            card.dataset.flipInitialized = "true";

            const front = card.querySelector<HTMLElement>(".valor-card__front");
            const back = card.querySelector<HTMLElement>(".valor-card__back");
            const buttons =
                card.querySelectorAll<HTMLButtonElement>("[data-flip-button]");

            const setFlipped = (flipped: boolean) => {
                card.classList.toggle("is-flipped", flipped);

                front?.setAttribute("aria-hidden", String(flipped));
                back?.setAttribute("aria-hidden", String(!flipped));

                if (flipped) {
                    front?.setAttribute("inert", "");
                    back?.removeAttribute("inert");
                } else {
                    back?.setAttribute("inert", "");
                    front?.removeAttribute("inert");
                }

                buttons.forEach((button) => {
                    button.setAttribute("aria-pressed", String(flipped));
                    button.setAttribute(
                        "aria-label",
                        flipped ? "Volver al frente" : "Ver más información",
                    );
                });
            };

            buttons.forEach((button) => {
                button.addEventListener("click", (e) => {
                    e.stopPropagation();
                    setFlipped(!card.classList.contains("is-flipped"));
                });
            });
        });
</script>
