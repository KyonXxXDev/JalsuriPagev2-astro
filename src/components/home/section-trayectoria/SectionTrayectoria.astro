---
/**
 * Línea de Tiempo Profesional Corporativa
 * Extraído de: agua_de_mesa_jalsuri_paleta_cl_sica_pureza_y_confianza.html (#trayectoria)
 * Adaptado a la paleta Jalsuri (primary #0084FF / secondary #00C2FF / text #0B3C73)
 * y sin Font Awesome (SVG inline).
 */

const icon = (paths: string) =>
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full" aria-hidden="true">${paths}</svg>`;

const icoCalendar = icon(
    '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/>',
);
const icoTimeline = icon(
    '<path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1"/><path d="M3 4.5v5h5"/><path d="M12 7.5V12l3 1.8"/>',
);
const icoDroplet = icon('<path d="M12 2.7l5.7 5.7a8 8 0 1 1-11.4 0z"/>');
const icoTruck = icon(
    '<path d="M3 6.5h11v10H3z"/><path d="M14 10h3.6l3.4 3.4v3.1h-7z"/><circle cx="7" cy="18.5" r="1.9"/><circle cx="17.5" cy="18.5" r="1.9"/>',
);
const icoAward = icon(
    '<circle cx="12" cy="8.5" r="5"/><path d="M8.6 12.8L7 21.5l5-2.8 5 2.8-1.6-8.7"/>',
);
const icoLeaf = icon(
    '<path d="M4.5 19.5C4.5 11 10.5 5 20 5c0 9.5-6 15.5-14 15.5H4.5z"/><path d="M4.5 19.5c3.5-3.5 7.5-5.5 11.5-6.5"/>',
);
const icoStar = icon(
    '<path d="M12 2.8l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.6l-5.8 3.1 1.1-6.5L2.6 9.6l6.5-.9z"/>',
);
const icoIndustry = icon(
    '<path d="M3 21V9l6 4V9l6 4V4h6v17z"/><path d="M3 21h18"/>',
);

type Stat = { label: string; value: string };

type Milestone = {
    year: string;
    tag: string;
    title: string;
    desc: string;
    category: "planta" | "cert" | "maquila";
    icon: string;
    stats: Stat[];
    highlight?: boolean;
};

const milestones: Milestone[] = [
    {
        year: "2012",
        tag: "Origen Industrial",
        title: "Constitución & Primera Planta de Purificación",
        desc: "Apertura de la planta física de Jalsuri. Módulos iniciales de tratamiento continuo con ozonización (O₃), ósmosis inversa y triple filtración de lecho profundo.",
        category: "planta",
        icon: icoDroplet,
        stats: [
            { label: "Capacidad Inicial", value: "1,200 LPH (Litros/Hora)" },
            { label: "Tecnología", value: "Ósmosis + Inyección O₃" },
        ],
    },
    {
        year: "2016",
        tag: "Modelo B2B & Comodato",
        title: "Especialización Corporativa y Comodato de Dispensadores",
        desc: "Lanzamiento de la división corporativa. Introducción del modelo de préstamos gratuitos de dispensadores eléctricos (frío/caliente) e integración de rutas logísticas propias.",
        category: "planta",
        icon: icoTruck,
        stats: [
            { label: "Empresas Atendidas", value: "+60 Clientes B2B" },
            { label: "Capacidad Instalada", value: "4,500 LPH" },
        ],
    },
    {
        year: "2019",
        tag: "Certificación Sanitaria",
        title: "Acreditación DIGESA / HACCP y Automatización",
        desc: "Implementación de la línea automatizada de lavado hermético a presión e inspección microbiológica continua. Obtención de certificaciones oficiales DIGESA.",
        category: "cert",
        icon: icoAward,
        stats: [
            { label: "Standard Calidad", value: "DIGESA / HACCP" },
            { label: "Capacidad Instalada", value: "8,000 LPH" },
        ],
    },
    {
        year: "2022",
        tag: "Maquila & Sostenibilidad",
        title: "Línea Maquila 3D & Resina Reciclada rPET",
        desc: "Inauguración de la división de etiquetado personalizado para eventos y corporativos. Transición hacia resinas de plástico 100% reciclable (rPET) y empaques de vidrio.",
        category: "maquila",
        icon: icoLeaf,
        stats: [
            { label: "Producción Maquila", value: "+1.5M Botellas/año" },
            { label: "Sustentabilidad", value: "Uso de rPET Reciclado" },
        ],
    },
    {
        year: "2026 Actualidad",
        tag: "Liderazgo Industrial",
        title: "Consolidación B2B, Simulación 3D & Meta Hídrica",
        desc: "Más de 180 contratos activos en minería, clínicas y banca. Integración del estudio 3D web de maquetación, calculadora hídrica de consumo y programa de neutralidad.",
        category: "planta",
        icon: icoStar,
        stats: [
            { label: "Capacidad Total", value: "15,000 LPH" },
            { label: "Clientes Corporativos", value: "180+ Empresas" },
        ],
        highlight: true,
    },
];

---

<section
    id="trayectoria"
    class="relative z-30 overflow-hidden bg-gradient-to-b from-white via-sky-50/25 to-white"
>
    <!-- Luces ambientales de fondo -->
    <div
        class="absolute top-1/4 -left-32 w-96 h-96 bg-sky-200/40 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
        class="absolute bottom-1/4 -right-32 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <!-- Contenedor anclado (Pinned Wrapper) -->
    <div
        id="trayectoria-wrapper"
        class="relative w-full h-screen overflow-hidden flex flex-col justify-between py-6 sm:py-8"
    >
        <!-- Header superior fijo dentro de la sección anclada -->
        <header
            class="relative z-20 px-6 sm:px-12 max-w-7xl mx-auto w-full flex flex-col md:flex-row items-start md:items-end justify-between gap-4 shrink-0"
        >
            <div class="space-y-1">
                <div class="inline-flex items-center gap-2.5">
                    <span class="w-6 h-0.5 bg-secondary"></span>
                    <span
                        class="text-secondary font-bold text-xs tracking-[0.2em] uppercase"
                    >
                        Evolución Estratégica
                    </span>
                    <span class="w-6 h-0.5 bg-secondary"></span>
                </div>
                <h2
                    class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-text tracking-tight font-display leading-tight"
                >
                    Línea de Tiempo <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary"
                        >Profesional Corporativa</span
                    >
                </h2>
                <p class="text-text/70 text-xs sm:text-sm max-w-2xl">
                    Más de una década de escalamiento en LPH, certificaciones sanitarias DIGESA/HACCP, resina rPET y maquila corporativa.
                </p>
            </div>

            <!-- Navegación interactiva por años y control de hitos -->
            <div class="flex items-center gap-2.5 sm:gap-3 shrink-0 flex-wrap">
                <div
                    class="flex items-center p-1 bg-white/90 backdrop-blur-md rounded-2xl border border-slate-200/80 shadow-xs"
                >
                    {
                        milestones.map((m, idx) => (
                            <button
                                type="button"
                                class:list={[
                                    "timeline-step-btn px-2.5 sm:px-3 py-1 text-xs font-bold rounded-xl transition-all duration-200 cursor-pointer",
                                    idx === 0
                                        ? "bg-primary text-white shadow-sm shadow-primary/30"
                                        : "text-slate-500 hover:text-primary hover:bg-slate-50",
                                ]}
                                data-step-index={idx}
                                aria-label={`Ir al hito ${m.year}`}
                            >
                                {m.year.split(" ")[0]}
                            </button>
                        ))
                    }
                </div>

                <div
                    class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-primary/10 text-primary border border-primary/20 text-xs font-bold"
                >
                    <span class="w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
                    <span>Desliza para explorar</span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="w-3.5 h-3.5"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                        stroke-width="2.5"
                    >
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                </div>
            </div>
        </header>

        <!-- Track horizontal de paneles -->
        <div class="relative w-full flex-1 flex items-center overflow-hidden my-auto">
            <!-- Línea conectora horizontal central -->
            <div
                class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-1 bg-gradient-to-r from-secondary/30 via-primary/40 to-secondary/30 pointer-events-none z-0"
            >
            </div>

            <!-- Contenedor horizontal que se traslada con GSAP -->
            <div
                id="panels-container"
                class="flex flex-nowrap items-center h-full will-change-transform z-10"
            >
                {
                    milestones.map((m, idx) => (
                        <article
                            id={`panel-${idx + 1}`}
                            class="panel w-screen h-full shrink-0 flex items-center justify-center px-4 sm:px-8 lg:px-12 py-2 sm:py-4 select-none"
                            data-index={idx}
                        >
                            <div
                                class:list={[
                                    "relative w-full max-w-4xl mx-auto rounded-3xl p-6 sm:p-8 lg:p-10 transition-all duration-300 overflow-hidden backdrop-blur-xl border",
                                    m.highlight
                                        ? "bg-white/95 border-primary/40 shadow-2xl shadow-primary/15 ring-2 ring-primary/20"
                                        : "bg-white/90 border-slate-200/90 shadow-xl shadow-slate-200/60",
                                ]}
                            >
                                <!-- Marca de agua gigante del año -->
                                <span
                                    class="absolute -bottom-8 -right-4 font-display font-black text-7xl sm:text-9xl lg:text-[180px] leading-none select-none pointer-events-none text-slate-100/90 -z-0 tracking-tighter"
                                    aria-hidden="true"
                                >
                                    {m.year.split(" ")[0]}
                                </span>

                                <div class="relative z-10 space-y-4 sm:space-y-6">
                                    <!-- Fila superior: Badges y número de hito -->
                                    <div class="flex items-center justify-between gap-3 flex-wrap">
                                        <div class="flex items-center gap-2.5 flex-wrap">
                                            <span
                                                class:list={[
                                                    "px-3.5 py-1.5 rounded-xl font-black text-xs sm:text-sm text-white inline-flex items-center gap-2 shadow-xs",
                                                    m.highlight
                                                        ? "bg-gradient-to-r from-primary to-secondary"
                                                        : "bg-text",
                                                ]}
                                            >
                                                <span
                                                    class="w-3.5 h-3.5 inline-block"
                                                    set:html={icoCalendar}
                                                />
                                                {m.year}
                                            </span>

                                            <span
                                                class:list={[
                                                    "text-[10px] sm:text-xs uppercase tracking-wider font-extrabold px-3 py-1 rounded-xl border",
                                                    m.highlight
                                                        ? "text-primary bg-primary/10 border-primary/30"
                                                        : "text-slate-600 bg-slate-50 border-slate-200/80",
                                                ]}
                                            >
                                                {m.tag}
                                            </span>
                                        </div>

                                        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 text-slate-500 text-xs font-bold">
                                            <span>Hito</span>
                                            <span class="text-primary font-black">0{idx + 1}</span>
                                            <span>/</span>
                                            <span>0{milestones.length}</span>
                                        </div>
                                    </div>

                                    <!-- Fila central: Icono + Título + Descripción -->
                                    <div class="flex flex-col sm:flex-row items-start gap-4 sm:gap-6 pt-2">
                                        <div
                                            class:list={[
                                                "w-14 h-14 sm:w-16 sm:h-16 rounded-2xl flex items-center justify-center shrink-0 transition-transform duration-300 hover:scale-105",
                                                m.highlight
                                                    ? "bg-gradient-to-br from-primary to-secondary text-white shadow-lg shadow-primary/30"
                                                    : "bg-sky-50 text-primary border border-sky-100 shadow-sm",
                                            ]}
                                        >
                                            <span
                                                class="w-7 h-7 sm:w-8 sm:h-8 block"
                                                set:html={m.icon}
                                            />
                                        </div>

                                        <div class="space-y-2 flex-1">
                                            <h3
                                                class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-text font-display leading-tight tracking-tight"
                                            >
                                                {m.title}
                                            </h3>
                                            <p class="text-text/75 text-sm sm:text-base leading-relaxed max-w-3xl">
                                                {m.desc}
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Estadísticas / Métricas clave -->
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-3 border-t border-slate-100">
                                        {m.stats.map((s) => (
                                            <div class="bg-slate-50/90 p-3.5 sm:p-4 rounded-2xl border border-slate-100/90 flex flex-col justify-center">
                                                <span class="text-slate-400 block text-[10px] sm:text-xs uppercase font-bold tracking-wider mb-1">
                                                    {s.label}
                                                </span>
                                                <span class="text-text font-black text-sm sm:text-base">
                                                    {s.value}
                                                </span>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>

        <!-- Footer inferior con barra de progreso y navegación -->
        <footer
            class="relative z-20 px-6 sm:px-12 max-w-7xl mx-auto w-full flex items-center justify-between gap-4 text-xs font-semibold text-slate-500 shrink-0"
        >
            <div class="flex items-center gap-2">
                <span class="text-slate-400">Inicio:</span>
                <span class="font-bold text-text">2012</span>
            </div>

            <!-- Barra de progreso continua -->
            <div class="flex-1 max-w-md mx-2 sm:mx-6 flex flex-col items-center gap-1.5">
                <div class="w-full h-2 bg-slate-200/80 rounded-full overflow-hidden p-0.5">
                    <div
                        id="timeline-progress-bar"
                        class="h-full bg-gradient-to-r from-primary to-secondary w-0 rounded-full transition-all duration-75"
                    >
                    </div>
                </div>
                <div class="flex items-center justify-between w-full text-[10px] text-slate-400 font-bold">
                    <span id="timeline-step-counter">01 / 0{milestones.length}</span>
                    <span>Desplazamiento horizontal</span>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <span class="text-slate-400">Meta:</span>
                <span class="font-bold text-primary">2026</span>
            </div>
        </footer>
    </div>
</section>

<script>
    
import { gsap } from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";

gsap.registerPlugin(ScrollTrigger);

let cleanup: (() => void) | undefined;

function initTimelinePanels() {
    cleanup?.();
    cleanup = undefined;

    const section = document.querySelector<HTMLElement>("#trayectoria");
    const wrapper = document.querySelector<HTMLElement>(
        "#trayectoria-wrapper",
    );
    const container = document.querySelector<HTMLElement>(
        "#panels-container",
    );
    const panels = gsap.utils.toArray<HTMLElement>(
        "#panels-container .panel",
    );
    const buttons = gsap.utils.toArray<HTMLButtonElement>(
        ".timeline-step-btn",
    );

    if (!section || !wrapper || !container || panels.length < 2) return;

    const totalPanels = panels.length;
    const ctx = gsap.context(() => {
        let activeIndex = -1;

        // Medir el desplazamiento horizontal real.
        const getDistance = () =>
            Math.max(0, container.scrollWidth - wrapper.clientWidth);

        // Mover el contenedor completo, no cada panel individual.
        const horizontalTween = gsap.to(container, {
            x: () => -getDistance(),
            ease: "none",
            scrollTrigger: {
                id: "trayectoria-horizontal",
                trigger: wrapper,
                pin: wrapper,
                start: "top top",
                end: () => `+=${getDistance()}`,
                scrub: 0.6,
                anticipatePin: 1,
                invalidateOnRefresh: true,

                snap: {
                    snapTo: (progress) => {
                        const steps = totalPanels - 1;
                        return Math.round(progress * steps) / steps;
                    },
                    duration: { min: 0.15, max: 0.35 },
                    ease: "power1.inOut",
                },

                onUpdate: (self) => {
                    const progress = self.progress;

                    const bar = document.querySelector<HTMLElement>(
                        "#timeline-progress-bar",
                    );

                    if (bar) {
                        bar.style.width = `${progress * 100}%`;
                    }

                    const index = Math.min(
                        totalPanels - 1,
                        Math.round(progress * (totalPanels - 1)),
                    );

                    if (index === activeIndex) return;
                    activeIndex = index;

                    buttons.forEach((button, i) => {
                        const isActive = i === index;

                        button.classList.toggle("bg-primary", isActive);
                        button.classList.toggle("text-white", isActive);
                        button.classList.toggle(
                            "shadow-sm",
                            isActive,
                        );
                        button.classList.toggle(
                            "shadow-primary/30",
                            isActive,
                        );

                        button.classList.toggle(
                            "text-slate-500",
                            !isActive,
                        );
                        button.setAttribute(
                            "aria-current",
                            isActive ? "step" : "false",
                        );
                    });

                    const counter = document.querySelector<HTMLElement>(
                        "#timeline-step-counter",
                    );

                    if (counter) {
                        counter.textContent =
                            `${String(index + 1).padStart(2, "0")} / ` +
                            `${String(totalPanels).padStart(2, "0")}`;
                    }
                },
            },
        });

        // Navegación directa a cada hito.
        buttons.forEach((button) => {
            const handleClick = () => {
                const index = Number(button.dataset.stepIndex ?? 0);
                const trigger = horizontalTween.scrollTrigger;

                if (!trigger) return;

                const progress = index / (totalPanels - 1);
                const target = trigger.start +
                    (trigger.end - trigger.start) * progress;

                // Compatible con Lenis cuando está integrado con GSAP.
                gsap.to(window, {
                    scrollTo: { y: target, autoKill: true },
                    duration: 0.8,
                    ease: "power2.out",
                });
            };

            button.addEventListener("click", handleClick);

            listeners.push(() => {
                button.removeEventListener("click", handleClick);
            });
        });
    }, section);

    function refresh() {
        ScrollTrigger.refresh();
    }

    const listeners: Array<() => void> = [];

    // Esperar a que el navegador calcule el layout.
    requestAnimationFrame(() => {
        ScrollTrigger.refresh();
    });

    window.addEventListener("resize", refresh);

    cleanup = () => {
        listeners.forEach((remove) => remove());
        window.removeEventListener("resize", refresh);
        ctx.revert();
    };
}

document.addEventListener("astro:page-load", initTimelinePanels);
document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = undefined;
});

// Primera carga y navegación de Astro.
if (document.readyState !== "loading") {
    initTimelinePanels();
} else {
    document.addEventListener(
        "DOMContentLoaded",
        initTimelinePanels,
        { once: true },
    );
}

</script>

<style>
    #panels-container {
        backface-visibility: hidden;
        transform: translateZ(0);
    }
</style>
