---
import ChevronDown from "../icons/ChevronDown.astro";
---

<div
    id="scroll-indicator"
    class="fixed w-full bottom-0 z-20 flex flex-col items-center justify-end pointer-events-none text-sky-50"
>
    <div class="flex flex-col items-center gap-1.5 px-4 py-2">
        <span
            class="text-[10px] tracking-[0.3em] uppercase font-bold drop-shadow-[0_0_8px_rgba(56,189,248,0.8)]"
        >
            Desliza para explorar
        </span>
        <ChevronDown
            class="h-auto w-10 animate-bounce drop-shadow-[0_0_8px_rgba(56,189,248,0.9)]"
        />
    </div>
</div>
