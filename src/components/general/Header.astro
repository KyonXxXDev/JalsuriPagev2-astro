---
import Button from "./Button";
import WhatsApp from "../icons/WhatsApp.astro";
import { navLinks } from "../texts";
import GooeyNav from "./GooeyNav";
---

<!-- HEADER CORPORATIVO FIJO -->
<header
    id="main-header"
    class="fixed top-0 left-0 w-full z-50 px-4 sm:px-8 lg:px-12 py-3.5 transition-all duration-300 pointer-events-auto backdrop-blur-xl shadow-sm shadow-text/10 bg-background/50"
>
    <div
        class="max-w-7xl mx-auto flex justify-between items-center text-background"
    >
        <!-- Logo + Brand Name -->
        <a
            href="/#hero-container"
            class="flex items-center gap-2 group focus:outline-none"
        >
            <div class="p-1 transition-transform group-hover:scale-105">
                <img
                    src="/only-logo.svg"
                    alt="Jalsuri Logo"
                    class="h-8 w-auto object-contain drop-shadow-sm"
                />
            </div>
        </a>

        <!-- Navigation Menu (Desktop) -->
        <nav
            class="hidden lg:flex items-center gap-6 xl:gap-8 text-sm font-medium"
        >
            <GooeyNav
                items={navLinks}
                theme="light"
                color="#0084FF"
                colors={["#0084FF", "#00C2FF", "#004080"]}
                size="md"
                gooeyness={0.5}
                particleCount={15}
                client:visible
            />
        </nav>

        <!-- Right CTA Button (Desktop) & Mobile Toggle Checkbox -->
        <div class="flex items-center gap-4">
            <div class="hidden lg:block">
                <Button
                    href="https://wa.me/51997673300"
                    target="_blank"
                    variant="primary"
                    size="sm"
                    className="flex justify-center items-center"
                >
                    <WhatsApp class="size-4 text-white" />
                    Cotizar Ahora
                </Button>
            </div>

            <!-- Mobile Menu Toggle (Checkbox + Label Animation) -->
            <label
                class="bar block lg:hidden"
                for="mobile-menu-checkbox"
                aria-label="Abrir menú de navegación"
            >
                <input type="checkbox" id="mobile-menu-checkbox" />
                <span class="top"></span>
                <span class="middle"></span>
                <span class="bottom"></span>
            </label>
        </div>
    </div>

    <!-- Mobile Navigation Drawer (Oculto por defecto con "hidden") -->
    <div
        id="mobile-menu"
        class="hidden mt-4 pt-4 border-t border-secondary/20 gap-3 pb-4 px-2 text-text font-medium text-sm animate-fadeIn"
    >
        <nav class="flex flex-col gap-1">
            {
                navLinks.map((link) => (
                    <a
                        href={link.href}
                        class="px-4 py-2.5 rounded-lg hover:bg-primary/10 hover:text-primary transition-colors duration-200"
                    >
                        {link.label}
                    </a>
                ))
            }
        </nav>

        <div class="pt-2 sm:hidden flex justify-center">
            <Button
                text="Cotizar Ahora"
                href="https://wa.me/51997673300"
                target="_blank"
                variant="gradient"
                size="sm"
                className="w-full justify-center hover:animate-pulse"
            >
                <WhatsApp class="size-4 text-white" />
            </Button>
        </div>
    </div>
</header>

<!-- Estilos CSS para el icono animado de hamburguesa a cruz -->
<style>
    input[type="checkbox"] {
        -webkit-appearance: none;
        display: none;
        visibility: hidden;
    }

    .bar {
        position: relative;
        cursor: pointer;
        width: 36px;
        height: 28px;
    }

    .bar span {
        position: absolute;
        width: 100%;
        height: 4px;
        background: var(--color-text);
        border-radius: 100px;
        display: inline-block;
        transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        left: 0;
    }

    .bar span.top {
        top: 0;
    }

    .bar span.middle {
        top: 12px;
    }

    .bar span.bottom {
        bottom: 0;
    }

    /* Animaciones cuando el checkbox está activo */
    #mobile-menu-checkbox:checked ~ span.top {
        transform: rotate(45deg);
        transform-origin: 10% 10%;
        top: 2px;
    }

    #mobile-menu-checkbox:checked ~ span.bottom {
        transform: rotate(-45deg);
        transform-origin: 10% 90%;
        bottom: 2px;
    }

    #mobile-menu-checkbox:checked ~ span.middle {
        transform: translateX(-20px);
        opacity: 0;
    }
</style>

<script>
    const checkbox = document.getElementById(
        "mobile-menu-checkbox",
    ) as HTMLInputElement;
    const mobileMenu = document.getElementById("mobile-menu");

    if (checkbox && mobileMenu) {
        // Sincronizar apertura/cierre del menú móvil con el estado del input checkbox
        checkbox.addEventListener("change", () => {
            if (checkbox.checked) {
                mobileMenu.classList.remove("hidden");
            } else {
                mobileMenu.classList.add("hidden");
            }
        });

        // Cerrar automáticamente el menú al hacer clic en cualquier enlace interno
        mobileMenu.querySelectorAll("a").forEach((link) => {
            link.addEventListener("click", () => {
                mobileMenu.classList.add("hidden");
                checkbox.checked = false;
            });
        });
    }
</script>
