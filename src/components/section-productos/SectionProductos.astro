---
import imgBidon from "@/assets/img/bidon.webp";
import imgBidon20 from "@/assets/img/20LT-OKAS.webp";
import imgBotellas from "@/assets/img/produc-y-element-5-1024x867.webp";
import imgPorPortada from "@/assets/img/PORTADA-WEB-JALSURI-BIDON-8.5-LITROS_2.webp";
import imgElement1 from "@/assets/img/produc-y-element-1-1024x867.webp";
import imgElement9 from "@/assets/img/produc-y-element-9-1024x867.webp";

const WA = "https://wa.me/51997673300";

const presentaciones = [
    {
        size: "500 ml",
        name: "Botella Personal",
        desc: "Ideal para llevar, gimnasios, colegios y consumo rápido fuera de casa.",
        tag: "Diaria",
        img: imgBotellas,
    },
    {
        size: "625 ml",
        name: "Botella Clásica",
        desc: "El formato clásico para escritorios, reuniones y tu día laboral.",
        tag: "Oficina",
        img: imgElement1,
    },
    {
        size: "1 Litro",
        name: "Botella Familiar",
        desc: "Mayor rendimiento para compartir en casa o en trayectos largos.",
        tag: "Familiar",
        img: imgElement9,
    },
];

const bidonesCano = [
    {
        size: "7 Litros",
        desc: "Práctico para mesas, reuniones y espacios reducidos. No requiere dispensador.",
        img: imgPorPortada,
    },
    {
        size: "10 Litros",
        desc: "Mayor capacidad para oficinas pequeñas y eventos de media jornada.",
        img: imgBidon,
    },
];
---

<section
    id="productos"
    class="relative z-30 bg-slate-50 text-slate-900 py-24 px-6 md:px-16 overflow-hidden"
>
    <!-- Luces ambientales -->
    <div
        class="absolute top-0 -right-32 w-96 h-96 bg-sky-200/40 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
        class="absolute bottom-0 -left-32 w-96 h-96 bg-blue-200/30 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <div class="max-w-7xl mx-auto space-y-14 relative z-10">
        <!-- Cabecera -->
        <div class="text-center space-y-4 max-w-3xl mx-auto">
            <span
                class="text-sky-700 text-xs font-bold tracking-[0.3em] uppercase bg-sky-100 border border-sky-200 px-4 py-1.5 rounded-full inline-block"
            >
                Catálogo Completo
            </span>
            <h2
                class="text-3xl sm:text-5xl font-extrabold text-slate-900 font-display tracking-tight leading-tight"
            >
                Productos y <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary"
                    >Presentaciones</span
                >
            </h2>
            <p class="text-slate-600 text-base sm:text-lg">
                Elige el formato perfecto para tu hogar, oficina o evento.
                Todas nuestras presentaciones llevan la pureza Jalsuri.
            </p>
        </div>

        <!-- Botellón 20L destacado con modelo 3D -->
        <article
            class="group bg-white rounded-3xl border border-slate-200/80 shadow-xl shadow-sky-950/5 hover:shadow-2xl hover:shadow-sky-500/15 transition-all duration-500 p-8 md:p-10 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center"
        >
            <div class="order-2 lg:order-1 space-y-5">
                <span
                    class="inline-block bg-sky-500 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider"
                >
                    El más popular
                </span>
                <h3
                    class="text-2xl sm:text-3xl font-extrabold font-display text-slate-900"
                >
                    Botellón de 20 Litros
                </h3>
                <p class="text-slate-600 leading-relaxed">
                    El formato preferido para dispensadores en hogares y
                    oficinas. Bidones retornables BPA-Free, ergonómicos y
                    recargables para un consumo responsable.
                </p>
                <ul class="space-y-2 text-sm text-slate-700">
                    <li class="flex items-center gap-2">
                        <span
                            class="w-1.5 h-1.5 rounded-full bg-secondary"
                        ></span> Compatible con dispensadores estándar
                    </li>
                    <li class="flex items-center gap-2">
                        <span
                            class="w-1.5 h-1.5 rounded-full bg-secondary"
                        ></span> Incluye entrega y retiro del bidón vacío
                    </li>
                    <li class="flex items-center gap-2">
                        <span
                            class="w-1.5 h-1.5 rounded-full bg-secondary"
                        ></span> Ozonizado y libre de cloro
                    </li>
                </ul>
                <div class="flex flex-wrap items-center gap-4 pt-2">
                    <a
                        href={`${WA}?text=Hola,%20deseo%20pedir%20un%20botell%C3%B3n%20de%2020L`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-6 py-3 rounded-full bg-primary text-white font-bold text-sm hover:bg-secondary transition-colors shadow-lg shadow-primary/25"
                    >
                        Pedir por WhatsApp
                    </a>
                    <span class="text-xs text-slate-500 font-medium"
                        >Gira el modelo 3D para verlo →</span
                    >
                </div>
            </div>

            <div
                class="order-1 lg:order-2 relative aspect-square rounded-2xl bg-linear-to-br from-sky-50 to-white border border-sky-100 flex items-center justify-center overflow-hidden p-6"
            >
                <img
                    src={imgBidon20.src}
                    alt="Botellón Jalsuri de 20 litros"
                    class="w-full h-full object-contain transition-transform duration-700 ease-out group-hover:scale-105"
                />
                <span
                    class="absolute bottom-4 left-4 bg-white/80 backdrop-blur-md text-sky-700 text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider border border-sky-100"
                >
                    Ver modelo 3D ↓
                </span>
            </div>
        </article>

        <!-- Presentaciones personales -->
        <div class="space-y-6">
            <h3 class="text-xl font-bold font-display text-slate-900">
                Presentaciones Personales
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                {
                    presentaciones.map((p) => (
                        <article class="group bg-white p-6 rounded-3xl border border-slate-200/80 shadow-lg shadow-sky-950/5 hover:border-sky-400 hover:shadow-2xl hover:shadow-sky-500/15 transition-all duration-500 flex flex-col justify-between">
                            <div>
                                <div class="relative overflow-hidden aspect-square bg-sky-50 rounded-2xl p-4 flex items-center justify-center">
                                    <img
                                        src={p.img.src}
                                        alt={`${p.name} ${p.size}`}
                                        class="w-full h-full object-contain transition-transform duration-700 ease-out group-hover:scale-105"
                                    />
                                    <span class="absolute top-3 right-3 bg-sky-500 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider">
                                        {p.tag}
                                    </span>
                                </div>
                                <div class="pt-6 space-y-2">
                                    <span class="text-primary font-extrabold text-2xl font-display">
                                        {p.size}
                                    </span>
                                    <h4 class="text-xl font-bold text-slate-900 font-display group-hover:text-sky-600 transition-colors">
                                        {p.name}
                                    </h4>
                                    <p class="text-xs text-slate-600 leading-relaxed">
                                        {p.desc}
                                    </p>
                                </div>
                            </div>
                            <div class="pt-6 border-t border-slate-100 mt-6 flex items-center justify-end">
                                <a
                                    href={`${WA}?text=Hola,%20deseo%20informaci%C3%B3n%20sobre%20la%20presentaci%C3%B3n%20de%20${p.size}`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="px-4 py-2 rounded-full bg-sky-50 group-hover:bg-sky-500 text-sky-600 group-hover:text-white font-semibold text-xs transition-colors"
                                >
                                    Pedir Ahora →
                                </a>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>

        <!-- Bidones con caño -->
        <div class="space-y-6">
            <h3 class="text-xl font-bold font-display text-slate-900">
                Bidones con Caño — Uso Directo
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                {
                    bidonesCano.map((b) => (
                        <article class="group bg-white p-6 rounded-3xl border border-slate-200/80 shadow-lg shadow-sky-950/5 hover:border-sky-400 hover:shadow-2xl hover:shadow-sky-500/15 transition-all duration-500 flex flex-col sm:flex-row gap-6 items-center">
                            <div class="w-40 h-40 shrink-0 bg-sky-50 rounded-2xl p-4 flex items-center justify-center">
                                <img
                                    src={b.img.src}
                                    alt={`Bidón Jalsuri con caño de ${b.size}`}
                                    class="w-full h-full object-contain transition-transform duration-700 group-hover:scale-105"
                                />
                            </div>
                            <div class="space-y-3 text-center sm:text-left">
                                <span class="text-primary font-extrabold text-2xl font-display">
                                    {b.size}
                                </span>
                                <p class="text-sm text-slate-600 leading-relaxed">
                                    {b.desc}
                                </p>
                                <a
                                    href={`${WA}?text=Hola,%20deseo%20informaci%C3%B3n%20sobre%20el%20bid%C3%B3n%20de%20${b.size.replace(" ", "%20")}%20con%20ca%C3%B1o`}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-block px-4 py-2 rounded-full bg-sky-50 group-hover:bg-sky-500 text-sky-600 group-hover:text-white font-semibold text-xs transition-colors"
                                >
                                    Consultar Precio →
                                </a>
                            </div>
                        </article>
                    ))
                }
            </div>
        </div>
    </div>
</section>
