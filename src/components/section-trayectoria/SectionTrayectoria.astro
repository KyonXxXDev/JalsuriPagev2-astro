---
/**
 * Línea de Tiempo Profesional Corporativa
 * Extraído de: agua_de_mesa_jalsuri_paleta_cl_sica_pureza_y_confianza.html (#trayectoria)
 * Adaptado a la paleta Jalsuri (primary #0084FF / secondary #00C2FF / text #0B3C73)
 * y sin Font Awesome (SVG inline).
 */

const icon = (paths: string) =>
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full" aria-hidden="true">${paths}</svg>`;

const icoCalendar = icon(
    '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/>',
);
const icoTimeline = icon(
    '<path d="M3.5 12a8.5 8.5 0 1 0 2.6-6.1"/><path d="M3 4.5v5h5"/><path d="M12 7.5V12l3 1.8"/>',
);
const icoDroplet = icon('<path d="M12 2.7l5.7 5.7a8 8 0 1 1-11.4 0z"/>');
const icoTruck = icon(
    '<path d="M3 6.5h11v10H3z"/><path d="M14 10h3.6l3.4 3.4v3.1h-7z"/><circle cx="7" cy="18.5" r="1.9"/><circle cx="17.5" cy="18.5" r="1.9"/>',
);
const icoAward = icon(
    '<circle cx="12" cy="8.5" r="5"/><path d="M8.6 12.8L7 21.5l5-2.8 5 2.8-1.6-8.7"/>',
);
const icoLeaf = icon(
    '<path d="M4.5 19.5C4.5 11 10.5 5 20 5c0 9.5-6 15.5-14 15.5H4.5z"/><path d="M4.5 19.5c3.5-3.5 7.5-5.5 11.5-6.5"/>',
);
const icoStar = icon(
    '<path d="M12 2.8l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.6l-5.8 3.1 1.1-6.5L2.6 9.6l6.5-.9z"/>',
);
const icoIndustry = icon(
    '<path d="M3 21V9l6 4V9l6 4V4h6v17z"/><path d="M3 21h18"/>',
);

type Stat = { label: string; value: string };

type Milestone = {
    year: string;
    tag: string;
    title: string;
    desc: string;
    category: "planta" | "cert" | "maquila";
    icon: string;
    stats: Stat[];
    highlight?: boolean;
};

const milestones: Milestone[] = [
    {
        year: "2012",
        tag: "Origen Industrial",
        title: "Constitución & Primera Planta de Purificación",
        desc: "Apertura de la planta física de Jalsuri. Módulos iniciales de tratamiento continuo con ozonización (O₃), ósmosis inversa y triple filtración de lecho profundo.",
        category: "planta",
        icon: icoDroplet,
        stats: [
            { label: "Capacidad Inicial", value: "1,200 LPH (Litros/Hora)" },
            { label: "Tecnología", value: "Ósmosis + Inyección O₃" },
        ],
    },
    {
        year: "2016",
        tag: "Modelo B2B & Comodato",
        title: "Especialización Corporativa y Comodato de Dispensadores",
        desc: "Lanzamiento de la división corporativa. Introducción del modelo de préstamos gratuitos de dispensadores eléctricos (frío/caliente) e integración de rutas logísticas propias.",
        category: "planta",
        icon: icoTruck,
        stats: [
            { label: "Empresas Atendidas", value: "+60 Clientes B2B" },
            { label: "Capacidad Instalada", value: "4,500 LPH" },
        ],
    },
    {
        year: "2019",
        tag: "Certificación Sanitaria",
        title: "Acreditación DIGESA / HACCP y Automatización",
        desc: "Implementación de la línea automatizada de lavado hermético a presión e inspección microbiológica continua. Obtención de certificaciones oficiales DIGESA.",
        category: "cert",
        icon: icoAward,
        stats: [
            { label: "Standard Calidad", value: "DIGESA / HACCP" },
            { label: "Capacidad Instalada", value: "8,000 LPH" },
        ],
    },
    {
        year: "2022",
        tag: "Maquila & Sostenibilidad",
        title: "Línea Maquila 3D & Resina Reciclada rPET",
        desc: "Inauguración de la división de etiquetado personalizado para eventos y corporativos. Transición hacia resinas de plástico 100% reciclable (rPET) y empaques de vidrio.",
        category: "maquila",
        icon: icoLeaf,
        stats: [
            { label: "Producción Maquila", value: "+1.5M Botellas/año" },
            { label: "Sustentabilidad", value: "Uso de rPET Reciclado" },
        ],
    },
    {
        year: "2026 Actualidad",
        tag: "Liderazgo Industrial",
        title: "Consolidación B2B, Simulación 3D & Meta Hídrica",
        desc: "Más de 180 contratos activos en minería, clínicas y banca. Integración del estudio 3D web de maquetación, calculadora hídrica de consumo y programa de neutralidad.",
        category: "planta",
        icon: icoStar,
        stats: [
            { label: "Capacidad Total", value: "15,000 LPH" },
            { label: "Clientes Corporativos", value: "180+ Empresas" },
        ],
        highlight: true,
    },
];

const filters = [
    { id: "all", label: "Todos los Hitos", icon: "" },
    { id: "planta", label: "Infraestructura & LPH", icon: icoIndustry },
    { id: "cert", label: "Calidad & DIGESA", icon: icoAward },
    { id: "maquila", label: "Maquila & rPET", icon: icoLeaf },
];
---

<section
    id="trayectoria"
    class="relative z-30 py-24 overflow-hidden bg-linear-to-b from-white via-white to-slate-50"
>
    <!-- Luces ambientales -->
    <div
        class="absolute top-1/4 -left-32 w-96 h-96 bg-sky-200/40 rounded-full blur-3xl pointer-events-none"
    >
    </div>
    <div
        class="absolute bottom-1/4 -right-32 w-96 h-96 bg-primary/10 rounded-full blur-3xl pointer-events-none"
    >
    </div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Cabecera de sección -->
        <div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
            <span
                class="px-4 py-1.5 rounded-full bg-secondary/10 text-primary border border-secondary/30 text-xs font-bold tracking-[0.25em] uppercase shadow-sm inline-flex items-center gap-2"
            >
                <span class="w-4 h-4 inline-block" set:html={icoTimeline}></span>
                Evolución Estratégica
            </span>
            <h2
                class="text-3xl sm:text-5xl font-extrabold text-text tracking-tight font-display leading-tight"
            >
                Línea de Tiempo <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-primary to-secondary"
                    >Profesional Corporativa</span
                >
            </h2>
            <p class="text-text/70 text-base sm:text-lg leading-relaxed">
                Trayectoria de Jalsuri: escalamiento de capacidad instalada en
                LPH, certificaciones microbiológicas DIGESA, adopción de rPET
                sustentable y liderazgo en maquetación 3D.
            </p>

            <!-- Filtros por categoría de hito -->
            <div class="flex flex-wrap justify-center gap-2 pt-2">
                {
                    filters.map((f) => (
                        <button
                            type="button"
                            data-tl-filter={f.id}
                            data-active={f.id === "all" ? "true" : "false"}
                            aria-pressed={f.id === "all" ? "true" : "false"}
                            class="tl-filter inline-flex items-center gap-1.5 px-4 py-1.5 rounded-xl text-xs font-semibold bg-white text-text border border-sky-200 hover:border-primary transition-all shadow-sm data-[active=true]:bg-primary data-[active=true]:text-white data-[active=true]:border-primary data-[active=true]:font-extrabold data-[active=true]:shadow-md data-[active=true]:shadow-primary/25"
                        >
                            {f.icon && (
                                <span
                                    class="w-3.5 h-3.5 inline-block"
                                    set:html={f.icon}
                                />
                            )}
                            {f.label}
                        </button>
                    ))
                }
            </div>
        </div>

        <!-- Estructura vertical de la línea de tiempo -->
        <div class="relative py-4">
            <!-- Columna vertebral -->
            <div
                class="absolute top-0 bottom-0 left-6 lg:left-1/2 -ml-0.5 w-1 bg-linear-to-b from-secondary via-primary to-text rounded-full opacity-40"
            >
            </div>

            <div class="space-y-12">
                {
                    milestones.map((m, i) => {
                        const reversed = i % 2 === 1;
                        return (
                            <div
                                class:list={[
                                    "tl-item relative flex flex-col items-center justify-between w-full group",
                                    reversed
                                        ? "lg:flex-row-reverse"
                                        : "lg:flex-row",
                                ]}
                                data-category={m.category}
                            >
                                <!-- Tarjeta del hito -->
                                <div class="order-1 pl-14 lg:pl-0 lg:w-[46%] w-full">
                                    <article
                                        class:list={[
                                            "p-6 rounded-3xl border transition-all duration-300 space-y-3",
                                            m.highlight
                                                ? "bg-white border-secondary shadow-xl shadow-primary/10"
                                                : "bg-white border-slate-200/80 shadow-sm group-hover:border-secondary group-hover:shadow-lg group-hover:shadow-primary/10",
                                        ]}
                                    >
                                        <div
                                            class="flex items-center justify-between gap-3"
                                        >
                                            <span
                                                class:list={[
                                                    "text-xs font-bold text-white px-3 py-1 rounded-lg inline-flex items-center gap-1.5",
                                                    m.highlight
                                                        ? "bg-linear-to-r from-primary to-text"
                                                        : "bg-text",
                                                ]}
                                            >
                                                <span
                                                    class="w-3.5 h-3.5 inline-block"
                                                    set:html={icoCalendar}
                                                />
                                                {m.year}
                                            </span>
                                            <span
                                                class:list={[
                                                    "text-[10px] uppercase tracking-wider font-bold px-2.5 py-1 rounded-md border",
                                                    m.highlight
                                                        ? "text-text bg-secondary/10 border-secondary/30"
                                                        : "text-slate-500 bg-slate-50 border-slate-100",
                                                ]}
                                            >
                                                {m.tag}
                                            </span>
                                        </div>

                                        <h3
                                            class="text-lg font-bold text-text group-hover:text-primary transition-colors"
                                        >
                                            {m.title}
                                        </h3>

                                        <p class="text-sm text-text/70 leading-relaxed">
                                            {m.desc}
                                        </p>

                                        <dl
                                            class="grid grid-cols-2 gap-2 pt-3 border-t border-slate-100 text-[11px]"
                                        >
                                            {m.stats.map((s) => (
                                                <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-100">
                                                    <dt class="text-slate-500 block text-[9px] uppercase font-bold tracking-wider">
                                                        {s.label}
                                                    </dt>
                                                    <dd class="text-text font-extrabold">
                                                        {s.value}
                                                    </dd>
                                                </div>
                                            ))}
                                        </dl>
                                    </article>
                                </div>

                                <!-- Nodo circular sobre la columna vertebral -->
                                <div
                                    class:list={[
                                        "absolute left-6 lg:left-1/2 -translate-x-1/2 z-20 flex items-center justify-center w-12 h-12 rounded-full transition-transform duration-300 group-hover:scale-110",
                                        m.highlight
                                            ? "bg-linear-to-r from-secondary to-primary text-white border-2 border-transparent shadow-lg shadow-primary/30"
                                            : "bg-white text-primary border-2 border-primary shadow-md",
                                    ]}
                                >
                                    <span
                                        class="w-5 h-5 block"
                                        set:html={m.icon}
                                    />
                                </div>

                                <div
                                    class="order-1 lg:w-[46%] hidden lg:block"
                                />
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </div>
</section>

<script>
    const root = document.getElementById("trayectoria");

    if (root) {
        const buttons = Array.from(
            root.querySelectorAll<HTMLButtonElement>("[data-tl-filter]"),
        );
        const items = Array.from(root.querySelectorAll<HTMLElement>(".tl-item"));

        // --- Filtros por categoría ---
        buttons.forEach((btn) => {
            btn.addEventListener("click", () => {
                const category = btn.dataset.tlFilter ?? "all";

                buttons.forEach((b) => {
                    const active = b === btn;
                    b.dataset.active = String(active);
                    b.setAttribute("aria-pressed", String(active));
                });

                items.forEach((item) => {
                    const match =
                        category === "all" ||
                        item.dataset.category === category;
                    item.style.display = match ? "" : "none";
                });
            });
        });

        // --- Revelado al hacer scroll (solo si hay soporte) ---
        if ("IntersectionObserver" in window) {
            items.forEach((el) => el.classList.add("tl-anim"));

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("tl-in");
                            observer.unobserve(entry.target);
                        }
                    });
                },
                { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
            );

            items.forEach((el) => observer.observe(el));
        }
    }
</script>

<style>
    .tl-anim {
        opacity: 0;
        transform: translateY(28px);
        transition:
            opacity 0.6s ease,
            transform 0.6s ease;
    }

    .tl-anim.tl-in {
        opacity: 1;
        transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .tl-anim {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>
