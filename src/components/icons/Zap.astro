---
import type { Props } from "../types";

const { class: classNameProp, className, ...rest } = Astro.props;
const iconClass = classNameProp ?? className ?? "h-10 w-auto text-white";
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={iconClass}
	{...rest}
>
	<path d="M13 10V3L4 14h7v7l9-11h-7z"></path>
</svg>
