---
import imgKey from "@/assets/logo.webp";
import imgCorporate from "@/assets/img/imgCorporate.webp";
---

<!-- 
  El footer principal tiene un z-index relativo para quedar por 
  encima de la imagen de fondo fijo que vendrá después.
-->
<footer
    class="bg-text text-background pt-16 relative z-10 border-t border-accent1/20 shadow-[0_-10px_30px_rgba(0,0,0,0.1)]"
>
    <div class="max-w-7xl mx-auto px-4 sm:px-8 lg:px-12">
        <!-- SECCIÓN 1: GRID PRINCIPAL (4 COLUMNAS) -->
        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12 pb-12"
        >
            <!-- Columna 1: Branding, Propósito y Mapa -->
            <div class="flex flex-col gap-6 lg:col-span-1">
                <!-- Branding -->
                <div>
                    <a
                        href="#hero-container"
                        class="flex items-center gap-3 group w-fit mb-4"
                    >
                        <div
                            class="p-1.5 rounded-xl bg-background/10 border border-accent1/30 backdrop-blur-sm transition-transform group-hover:scale-105 shadow-inner"
                        >
                            <img
                                src={imgKey.src}
                                alt="Jalsuri Logo"
                                class="h-9 w-auto object-contain brightness-0 invert"
                            />
                        </div>
                        <div class="flex flex-col">
                            <span
                                class="text-background font-extrabold text-xl tracking-tight font-display leading-tight group-hover:text-accent1 transition-colors"
                            >
                                JALSURI
                            </span>
                            <span
                                class="text-[10px] tracking-widest uppercase font-semibold text-accent1/80"
                            >
                                Agua Purificada
                            </span>
                        </div>
                    </a>
                    <p class="text-background/70 text-sm leading-relaxed pr-4">
                        Comprometidos con la pureza y el bienestar. Llevamos
                        agua de alta calidad procesada con tecnología de
                        vanguardia.
                    </p>
                </div>
            </div>

            <!-- Columna 2: Navegación -->
            <div class="flex flex-col gap-4">
                <h3
                    class="text-accent1 font-bold text-xs tracking-widest uppercase border-b border-accent1/20 pb-2 inline-block w-max"
                >
                    Navegación
                </h3>
                <ul class="space-y-3 text-sm text-background/80">
                    <li>
                        <a
                            href="#hero-container"
                            class="hover:text-accent1 hover:pl-2 transition-all duration-300 flex items-center gap-2"
                            >Inicio</a
                        >
                    </li>
                    <li>
                        <a
                            href="#compromiso"
                            class="hover:text-accent1 hover:pl-2 transition-all duration-300 flex items-center gap-2"
                            >Nosotros</a
                        >
                    </li>
                    <li>
                        <a
                            href="#productos"
                            class="hover:text-accent1 hover:pl-2 transition-all duration-300 flex items-center gap-2"
                            >Productos</a
                        >
                    </li>
                    <li>
                        <a
                            href="#maquila"
                            class="hover:text-accent1 hover:pl-2 transition-all duration-300 flex items-center gap-2"
                            >Maquila & Empresas</a
                        >
                    </li>
                    <li>
                        <a
                            href="#contacto"
                            class="hover:text-accent1 hover:pl-2 transition-all duration-300 flex items-center gap-2"
                            >Contacto</a
                        >
                    </li>
                </ul>
            </div>

            <!-- Columna 3: Servicios / Soluciones -->
            <div class="flex flex-col gap-4">
                <h3
                    class="text-accent1 font-bold text-xs tracking-widest uppercase border-b border-accent1/20 pb-2 inline-block w-max"
                >
                    Soluciones
                </h3>
                <ul class="space-y-3 text-sm text-background/80">
                    <li>
                        <span
                            class="hover:text-accent1 transition-colors cursor-pointer flex items-center gap-2"
                            ><span
                                class="w-1.5 h-1.5 rounded-full bg-accent1/50"
                            ></span> Bidones de 20 Litros</span
                        >
                    </li>
                    <li>
                        <span
                            class="hover:text-accent1 transition-colors cursor-pointer flex items-center gap-2"
                            ><span
                                class="w-1.5 h-1.5 rounded-full bg-accent1/50"
                            ></span> Botellas Personales</span
                        >
                    </li>
                    <li>
                        <span
                            class="hover:text-accent1 transition-colors cursor-pointer flex items-center gap-2"
                            ><span
                                class="w-1.5 h-1.5 rounded-full bg-accent1/50"
                            ></span> Maquila de Agua</span
                        >
                    </li>
                    <li>
                        <span
                            class="hover:text-accent1 transition-colors cursor-pointer flex items-center gap-2"
                            ><span
                                class="w-1.5 h-1.5 rounded-full bg-accent1/50"
                            ></span> Atención Corporativa</span
                        >
                    </li>
                </ul>
            </div>

            <!-- Columna 4: Contacto y Mapa -->
            <div class="flex flex-col gap-6">
                <!-- Contacto -->
                <div>
                    <h3
                        class="text-accent1 font-bold text-xs tracking-widest uppercase border-b border-accent1/20 pb-2 mb-4 inline-block w-max"
                    >
                        Atención Directa
                    </h3>
                    <div class="flex flex-col gap-3 text-sm text-background/80">
                        <a
                            href="https://wa.me/51997673300"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center gap-3 hover:text-accent1 transition-colors p-2 -ml-2 rounded-lg hover:bg-background/5"
                        >
                            <span
                                class="p-2 rounded-full bg-accent1/10 text-accent1"
                            >
                                <svg
                                    class="w-4 h-4"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                                    ></path>
                                </svg>
                            </span>
                            +51 997 673 300
                        </a>
                        <span class="flex items-center gap-3 p-2 -ml-2">
                            <span
                                class="p-2 rounded-full bg-accent1/10 text-accent1"
                            >
                                <svg
                                    class="w-4 h-4"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                                    ></path>
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                                    ></path>
                                </svg>
                            </span>
                            Lima, Perú
                        </span>
                    </div>
                </div>
            </div>
            <!-- Mapa Integrado (UI Mejorada) -->
            <div
                class="col-span-2 relative overflow-hidden rounded-xl border border-background/10 bg-background/5 p-1 shadow-lg group"
            >
                <div
                    class="absolute inset-0 bg-accent1/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-10"
                >
                </div>
                <iframe
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3902.274981293814!2d-76.9252699!3d-12.0246847!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9105c346572ebd63%3A0x9be48c071c6aca4!2sAgua%20de%20Mesa%20Jalsuri!5e0!3m2!1ses-419!2spe!4v1710000000000!5m2!1ses-419!2spe"
                    height="140"
                    class="rounded-lg w-full grayscale-[20%] contrast-125 hover:grayscale-0 transition-all duration-500"
                    allow="fullscreen"
                    loading="lazy"
                    title="Ubicación de Agua de Mesa Jalsuri en Google Maps"
                >
                </iframe>
            </div>
        </div>

        <!-- SECCIÓN 2: COPYRIGHT -->
        <div
            class="py-6 border-t border-background/10 flex flex-col sm:flex-row justify-between items-center gap-4 text-[11px] text-background/50 tracking-wide uppercase"
        >
            <p>
                © {new Date().getFullYear()} JALSURI. Todos los derechos reservados.
            </p>
            <div class="flex gap-6">
                <a href="#" class="hover:text-accent1 transition-colors"
                    >Términos</a
                >
                <a href="#" class="hover:text-accent1 transition-colors"
                    >Privacidad</a
                >
            </div>
        </div>
    </div>
    <div
        class="relative h-[50vh] w-full bg-cover bg-center bg-no-repeat flex items-center justify-center overflow-hidden pb-40"
        style={`background-image: url('${imgCorporate.src}');`}
    >
    </div>
</footer>
