---
import Layout from "../layouts/Layout.astro";

import FilaFlotante from "@/components/section-ficha-3d/FilaFlotante.astro";
import fichas from "@/data/fichas.json" with { type: "json" };

import imgBidon20 from "@/assets/img/bidon.webp";
import Viewer3D from "@/components/section-ficha-3d/Viewer3D.astro";
import ScrollIndicator from "@/components/general/ScrollIndicator.astro";

// Visual del producto para respaldo cuando el .glb no esté disponible
const visuales: Record<string, ImageMetadata> = {
	"bidon-20": imgBidon20,
};

const producto = fichas.productos[0];
const visual = visuales[producto.id];
const grupoIzq = producto.datos.slice(0, 4);
const grupoDer = producto.datos.slice(4);

const PDF = "/fichas-tecnicas/ficha-tecnica-jalsuri.pdf";

const solicitar = (nombre: string) =>
	`https://wa.me/51997673300?text=${encodeURIComponent(
		`Hola, deseo información sobre ${nombre}`,
	)}`;
---

<Layout
	title="Ficha Técnica | Bidón 20L – Jalsuri"
	description="Especificaciones técnicas y certificaciones del Bidón 20L Jalsuri. Formato estándar retornable con dispensador y comodato para hogares y empresas."
>
	<main class="relative w-full">
		<!-- ======================= ESCENARIO BIDÓN 20L ======================= -->
		<div id="escenario-bidon" class="relative w-full h-screen overflow-hidden">
			<!-- Visor 3D: Permanece activo y centrado durante ambas secciones -->
			<div
				class="absolute inset-0 h-full w-full overflow-hidden pointer-events-none z-10"
			>
				<!-- Burbujas decorativas del fondo -->
				<div
					class="absolute inset-0 flex items-center justify-center pointer-events-none -z-10 opacity-70"
				>
					<svg
						class="w-[340px] sm:w-[460px] lg:w-[540px] h-auto text-secondary/30 fill-current"
						viewBox="0 0 500 500"
						xmlns="http://www.w3.org/2000/svg"
						aria-hidden="true"
					>
						<circle
							cx="250"
							cy="250"
							r="190"
							class="text-primary/10 fill-current"></circle>
						<circle
							cx="140"
							cy="140"
							r="115"
							class="text-secondary/20 fill-current"></circle>
						<circle
							cx="370"
							cy="360"
							r="105"
							class="text-primary/15 fill-current"></circle>
						<circle
							cx="410"
							cy="110"
							r="85"
							class="text-secondary/25 fill-current"></circle>
						<circle
							cx="90"
							cy="320"
							r="70"
							class="text-primary/12 fill-current"></circle>
						<circle
							cx="320"
							cy="80"
							r="55"
							class="text-secondary/20 fill-current"></circle>
					</svg>
				</div>

				<Viewer3D
					modelos={producto.modelos}
					poster={visual.src}
					posterAlt={`Producto: ${producto.nombre}`}
					nombre={producto.nombre}
					data-viewer-3d
				/>
			</div>

			<!-- ================= SECCIÓN 1: TÍTULO Y PRESENTACIÓN ================= -->
			<section
				id="seccion-titulo"
				class="panel-section absolute inset-0 w-full h-full z-20 pointer-events-none"
			>
				<div class="outer w-full h-full overflow-hidden">
					<div
						class="inner w-full h-full overflow-hidden pt-24 sm:pt-28 pb-8 px-4 sm:px-8 flex flex-col justify-between pointer-events-none"
					>
						<div
							class="w-full flex flex-col justify-start items-start text-start pointer-events-auto"
							data-titulo-wrap
						>
							<div
								class="inline-flex items-center gap-2 sm:gap-3 mb-3 flex-wrap"
							>
								<span
									class="px-3 py-1 rounded-full bg-primary/10 border border-primary/25 text-primary text-xs font-bold uppercase tracking-wider"
								>
									{producto.categoria}
								</span>
								<span
									class="px-3.5 py-1.5 rounded-full bg-white/95 backdrop-blur border border-slate-200 text-text text-xs sm:text-sm font-extrabold shadow-xs"
								>
									Capacidad {producto.capacidad}
								</span>
							</div>
							<h1
								class="section-heading text-start text-balance font-display font-black text-text tracking-[-0.035em] leading-[0.92] text-5xl sm:text-7xl lg:text-8xl"
							>
								{producto.nombre}
							</h1>
							<p
								class="mt-4 md:max-w-2xl lg:max-w-xl text-text/75 text-sm sm:text-base leading-relaxed text-balance"
							>
								{producto.resumen}
							</p>
							<!-- Cabecera de la Ficha -->
							<div class="max-w-4xl" data-chips-wrap>
								<div
									class="mt-4 flex flex-wrap justify-start gap-2"
								>
									{
										producto.chips.map((c) => (
											<span class="px-3 py-1 rounded-full bg-white/80 backdrop-blur border border-primary/20 text-text text-xs font-semibold shadow-xs">
												{c}
											</span>
										))
									}
								</div>
							</div>
						</div>
						<div class="pointer-events-auto w-full flex justify-center">
							<ScrollIndicator color="text-text/75" />
						</div>
					</div>
				</div>
			</section>

			<!-- ================= SECCIÓN 2: ESPECIFICACIONES TÉCNICAS ================= -->
			<section
				id="seccion-especificaciones"
				class="panel-section absolute inset-0 w-full h-full z-20 pointer-events-none"
			>
				<div class="outer w-full h-full overflow-hidden">
					<div
						class="inner w-full h-full overflow-hidden pt-24 sm:pt-28 pb-8 px-4 sm:px-8 flex flex-col justify-between pointer-events-none"
						data-specs-wrap
					>
						<!-- Badge superior de Especificaciones -->
						<div
							class="max-w-4xl mx-auto px-4 text-center pointer-events-auto"
							data-specs-header
						>
							<button
								type="button"
								class="group inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/90 hover:bg-white backdrop-blur border border-primary/20 text-primary text-xs font-extrabold uppercase tracking-widest shadow-xs transition-all cursor-pointer focus:outline-none"
								aria-label="Volver a la presentación del producto"
							>
								<svg
									class="w-3.5 h-3.5 group-hover:-translate-y-0.5 transition-transform"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
								</svg>
								Especificaciones Técnicas &middot; {
									producto.nombre
								}
							</button>
						</div>

						<!-- Columnas de Especificaciones Flotantes (Escritorio) -->
						<dl
							class="hidden lg:flex flex-col gap-3 absolute left-6 xl:left-14 top-1/2 -translate-y-1/2 w-[18rem] xl:w-[20rem] z-30 pointer-events-auto"
							data-lado="izq"
						>
							{
								grupoIzq.map((d) => (
									<FilaFlotante
										label={d.label}
										value={d.value}
									/>
								))
							}
						</dl>
						<dl
							class="hidden lg:flex flex-col gap-3 absolute right-6 xl:right-14 top-1/2 -translate-y-1/2 w-[18rem] xl:w-[20rem] z-30 pointer-events-auto"
							data-lado="der"
						>
							{
								grupoDer.map((d) => (
									<FilaFlotante
										label={d.label}
										value={d.value}
									/>
								))
							}
						</dl>

						<!-- Móvil/tablet: olas centradas abajo -->
						<dl
							class="lg:hidden absolute inset-x-4 bottom-28 z-30 flex flex-col gap-2 pointer-events-auto"
							data-ola="0"
						>
							{
								grupoIzq.map((d) => (
									<FilaFlotante
										label={d.label}
										value={d.value}
									/>
								))
							}
						</dl>
						<dl
							class="lg:hidden absolute inset-x-4 bottom-28 z-30 flex flex-col gap-2 pointer-events-auto"
							data-ola="1"
						>
							{
								grupoDer.map((d) => (
									<FilaFlotante
										label={d.label}
										value={d.value}
									/>
								))
							}
						</dl>

						<!-- Barra de Acciones: Cotizar y Descargar Ficha PDF -->
						<div
							class="relative z-40 px-4 flex flex-wrap items-center justify-center gap-3 pointer-events-auto"
							data-cta
						>
							<a
								href={solicitar(producto.nombre)}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary text-white text-xs sm:text-sm font-bold uppercase tracking-wider shadow-lg shadow-primary/30 hover:bg-text hover:-translate-y-0.5 transition-all duration-300"
							>
								Cotizar este formato
								<svg
									class="w-4 h-4"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
								</svg>
							</a>
							{
								PDF && (
									<a
										href={PDF}
										download="ficha-tecnica-jalsuri.pdf"
										class="inline-flex items-center gap-2 px-5 py-3 rounded-full bg-white/95 hover:bg-white text-text border border-slate-200 text-xs sm:text-sm font-bold uppercase tracking-wider shadow-md hover:-translate-y-0.5 transition-all duration-300"
									>
										<svg
											class="w-4 h-4 text-primary"
											fill="none"
											stroke="currentColor"
											viewBox="0 0 24 24"
										>
											<path
												stroke-linecap="round"
												stroke-linejoin="round"
												stroke-width="2"
												d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
											/>
										</svg>
										Descargar Ficha PDF
									</a>
								)
							}
						</div>
					</div>
				</div>
			</section>
		</div>

		<!-- ======================= SECCIÓN DESCARGA OFICIAL PDF ======================= -->
		<section class="relative z-30 py-16 sm:py-24 bg-gradient-to-b from-slate-50 via-white to-slate-100">
			<div class="max-w-5xl mx-auto px-4 sm:px-8 lg:px-12">
				<div
					class="relative overflow-hidden rounded-3xl bg-text text-white p-8 sm:p-14 text-center shadow-2xl shadow-primary/20"
				>
					<div
						aria-hidden="true"
						class="pointer-events-none absolute -top-24 -right-16 w-72 h-72 rounded-full bg-primary/40 blur-3xl"
					>
					</div>
					<div
						aria-hidden="true"
						class="pointer-events-none absolute -bottom-28 -left-16 w-72 h-72 rounded-full bg-secondary/30 blur-3xl"
					>
					</div>

					<div class="relative z-10">
						<span
							class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 border border-white/20 text-xs font-bold tracking-[0.2em] uppercase text-white/90"
						>
							Documento Oficial
						</span>
						<h2
							class="mt-5 text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display tracking-tight text-white"
						>
							Llévate la ficha técnica completa
						</h2>
						<p
							class="mt-4 text-white/80 max-w-2xl mx-auto leading-relaxed text-sm sm:text-base"
						>
							Especificaciones químicas, microbiológicas y
							condiciones de servicio en un solo documento oficial
							DIGESA. Ideal para compartir con el área de compras
							o logística.
						</p>

						<div
							class="mt-8 flex flex-col sm:flex-row justify-center gap-4"
						>
							<a
								href={PDF}
								download="ficha-tecnica-jalsuri.pdf"
								class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full bg-white text-text font-extrabold text-sm uppercase tracking-wider shadow-xl shadow-black/20 hover:bg-secondary hover:text-white hover:-translate-y-1 transition-all duration-300"
							>
								<svg
									class="w-5 h-5"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M12 4v12m0 0l-4-4m4 4l4-4"
									></path>
								</svg>
								Descargar Ficha Técnica (PDF)
							</a>
							<a
								href={solicitar(
									"la ficha técnica del Bidón 20L y una cotización",
								)}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-full border border-white/40 text-white font-bold text-sm uppercase tracking-wider hover:bg-white/10 hover:-translate-y-1 transition-all duration-300"
							>
								Consultar a un Asesor
							</a>
						</div>

						<p class="mt-6 text-xs text-white/70 tracking-wide">
							Actualizado: {fichas.actualizado} · Formato A4 · PDF descargable
						</p>
					</div>
				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	import { gsap } from "gsap";

	const reduceMotion = window.matchMedia(
		"(prefers-reduced-motion: reduce)",
	).matches;

	if (!reduceMotion) {
		const escenario = document.getElementById("escenario-bidon");
		const viewer =
			escenario?.querySelector<HTMLElement>("[data-viewer-3d]");
		const sections = gsap.utils.toArray<HTMLElement>(".panel-section");
		const outerWrappers = gsap.utils.toArray<HTMLElement>(
			".panel-section .outer",
		);
		const innerWrappers = gsap.utils.toArray<HTMLElement>(
			".panel-section .inner",
		);

		const tituloWrap = document.querySelector("[data-titulo-wrap]");
		const chipsWrap = document.querySelector("[data-chips-wrap]");
		const scrollInd = document.querySelector("[data-scroll-indicator]");
		const specsHeader = document.querySelector("[data-specs-header]");
		const izq = document.querySelectorAll('[data-lado="izq"] [data-fila]');
		const der = document.querySelectorAll('[data-lado="der"] [data-fila]');
		const ola0 = document.querySelectorAll('[data-ola="0"] [data-fila]');
		const ola1 = document.querySelectorAll('[data-ola="1"] [data-fila]');
		const cta = document.querySelector("[data-cta]");

		const isDesktop = window.matchMedia("(min-width: 1024px)").matches;

		let currentIndex = -1;
		let animating = false;
		const sync3D = { progreso: 0 };

		function gotoSection(index: number, direction: number) {
			if (index < 0 || index >= sections.length) return;
			if (index === currentIndex && currentIndex !== -1) return;

			animating = true;
			const fromTop = direction === -1;
			const dFactor = fromTop ? -1 : 1;

			const tl = gsap.timeline({
				defaults: { duration: 0.95, ease: "power2.inOut" },
				onComplete: () => {
					animating = false;
				},
			});

			// 1. Salida de la sección actual
			if (currentIndex >= 0 && currentIndex !== index) {
				gsap.set(sections[currentIndex], { zIndex: 0 });
				tl.to(
					outerWrappers[currentIndex],
					{ yPercent: -100 * dFactor },
					0,
				).to(
					innerWrappers[currentIndex],
					{ yPercent: 100 * dFactor },
					0,
				);
			}

			// 2. Entrada de la sección destino con counter-slide
			gsap.set(sections[index], { autoAlpha: 1, zIndex: 1 });
			tl.fromTo(
				outerWrappers[index],
				{ yPercent: 100 * dFactor },
				{ yPercent: 0 },
				0,
			).fromTo(
				innerWrappers[index],
				{ yPercent: -100 * dFactor },
				{ yPercent: 0 },
				0,
			);

			// 3. Sincronización del modelo 3D (0 = Sección 0, 1 = Sección 1)
			tl.to(
				sync3D,
				{
					progreso: index,
					duration: 0.95,
					ease: "power2.inOut",
					onUpdate: () => {
						const fn = (viewer as any)?.actualizarProgreso3D;
						if (typeof fn === "function") {
							fn(sync3D.progreso);
						}
					},
				},
				0,
			);

			// 4. Micro-animaciones de contenido
			if (index === 0) {
				tl.fromTo(
					tituloWrap,
					{ opacity: 0, y: -20 },
					{ opacity: 1, y: 0, duration: 0.45, ease: "power1.out" },
					0.3,
				);
				if (chipsWrap) {
					tl.fromTo(
						chipsWrap,
						{ opacity: 0, y: 15 },
						{ opacity: 1, y: 0, duration: 0.35, ease: "power1.out" },
						0.4,
					);
				}
				if (scrollInd) {
					tl.fromTo(
						scrollInd,
						{ opacity: 0, y: 15 },
						{ opacity: 1, y: 0, duration: 0.35, ease: "power1.out" },
						0.45,
					);
				}
			} else if (index === 1) {
				tl.fromTo(
					specsHeader,
					{ opacity: 0, y: 15 },
					{ opacity: 1, y: 0, duration: 0.35, ease: "power1.out" },
					0.3,
				);

				if (isDesktop) {
					tl.fromTo(
						izq,
						{ opacity: 0, x: -30 },
						{
							opacity: 1,
							x: 0,
							duration: 0.35,
							stagger: 0.04,
							ease: "power1.out",
						},
						0.35,
					).fromTo(
						der,
						{ opacity: 0, x: 30 },
						{
							opacity: 1,
							x: 0,
							duration: 0.35,
							stagger: 0.04,
							ease: "power1.out",
						},
						0.4,
					);
				} else {
					tl.fromTo(
						ola0,
						{ opacity: 0, y: 20 },
						{
							opacity: 1,
							y: 0,
							duration: 0.3,
							stagger: 0.03,
							ease: "power1.out",
						},
						0.35,
					).fromTo(
						ola1,
						{ opacity: 0, y: 20 },
						{
							opacity: 1,
							y: 0,
							duration: 0.3,
							stagger: 0.03,
							ease: "power1.out",
						},
						0.45,
					);
				}

				if (cta) {
					tl.fromTo(
						cta,
						{ opacity: 0, y: 15 },
						{ opacity: 1, y: 0, duration: 0.35, ease: "power1.out" },
						0.55,
					);
				}
			}

			currentIndex = index;
		}

		// Preparar estado inicial
		gsap.set(sections, { autoAlpha: 0 });
		gsap.set(outerWrappers, { yPercent: 100 });
		gsap.set(innerWrappers, { yPercent: -100 });

		// Inicializar directamente en la Sección 0 (Presentación)
		gotoSection(0, 1);

		// Control de navegación natural por rueda del ratón
		window.addEventListener(
			"wheel",
			(e) => {
				if (animating) {
					e.preventDefault();
					return;
				}

				// En Sección 0: si gira hacia abajo, pasa a Sección 1
				if (currentIndex === 0 && e.deltaY > 10) {
					e.preventDefault();
					gotoSection(1, 1);
					return;
				}

				// En Sección 1 al tope superior: si gira hacia arriba, vuelve a Sección 0
				if (currentIndex === 1 && window.scrollY <= 5 && e.deltaY < -10) {
					e.preventDefault();
					gotoSection(0, -1);
					return;
				}

				// En cualquier otro caso (por ejemplo, en Sección 1 girando hacia abajo),
				// dejamos fluir el scroll nativo libremente para ver el PDF y Footer.
			},
			{ passive: false },
		);

		// Control táctil para móviles (Swipe Up / Down)
		let touchStartY = 0;
		window.addEventListener(
			"touchstart",
			(e) => {
				touchStartY = e.touches[0].clientY;
			},
			{ passive: true },
		);

		window.addEventListener(
			"touchend",
			(e) => {
				if (animating) return;
				const touchEndY = e.changedTouches[0].clientY;
				const deltaY = touchStartY - touchEndY; // positivo = deslizar hacia arriba (bajar)

				if (currentIndex === 0 && deltaY > 40) {
					gotoSection(1, 1);
				} else if (
					currentIndex === 1 &&
					window.scrollY <= 5 &&
					deltaY < -40
				) {
					gotoSection(0, -1);
				}
			},
			{ passive: true },
		);

		// Navegación por teclado
		window.addEventListener("keydown", (e) => {
			if (animating) return;
			if (e.key === "ArrowDown" || e.key === "PageDown" || e.key === " ") {
				if (currentIndex === 0) {
					e.preventDefault();
					gotoSection(1, 1);
				}
			} else if (e.key === "ArrowUp" || e.key === "PageUp") {
				if (currentIndex === 1 && window.scrollY <= 5) {
					e.preventDefault();
					gotoSection(0, -1);
				}
			}
		});

		// Navegación por clicks en elementos interactivos
		scrollInd?.addEventListener("click", (e) => {
			e.stopPropagation();
			if (!animating && currentIndex === 0) {
				gotoSection(1, 1);
			}
		});

		specsHeader?.addEventListener("click", (e) => {
			e.stopPropagation();
			if (!animating && currentIndex === 1) {
				window.scrollTo({ top: 0, behavior: "smooth" });
				gotoSection(0, -1);
			}
		});
	}
</script>
