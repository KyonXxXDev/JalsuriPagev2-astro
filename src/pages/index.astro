---
import Layout from "../layouts/Layout.astro";
import VideoKey from "@/assets/video/video-optimizado.mp4";
import ChevronDown from "@/components/icons/ChevronDown.astro";
import imgKey from "@/assets/logo.webp";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import SectionValores from "@/components/section-valores/SectionValores.astro";
import SectionBidon3D from "@/components/section-bidon3d/SectionBidon3D.astro";
import SectionProductos from "@/components/section-productos/SectionProductos.astro";
import ClientsSlider from "@/components/ClientsSlider";
import SectionCalidad from "@/components/section-calidad/SectionCalidad.astro";
import SectionTrayectoria from "@/components/section-trayectoria/SectionTrayectoria.astro";
import SectionDelivery from "@/components/section-delivery/SectionDelivery.astro";
---

<Layout>
	<Header />
	<!-- <picture id="global-waterfall" class="fixed top-0 left-0 w-screen h-screen -z-50 pointer-events-none">
       Overlay oscuro clave: Garantiza que cualquier texto encima se lea perfecto 
        <div class="absolute inset-0 bg-slate-950/60 z-10"></div>
        <video
            src={VideoWaterFall}
            class="w-full h-full object-cover scale-105" 
            muted autoplay loop playsinline preload="auto"
        ></video>
    </picture>-->
	<!-- 1. HERO SECTION CON MÁSCARA Y VIDEO (SIN OVERLAY) -->
	<section
		id="hero-container"
		class="relative w-full h-screen overflow-hidden"
	>
		<!-- Máscara con el logo y el video de fondo 
		<div
			id="logo-mask"
			class="w-full h-full absolute top-0 left-0 bg-black"
			style={`--mask-url: url('${imgKey.src}');`}
		></div>-->
		<picture
			id="hero-key"
			class="h-screen w-full block overflow-hidden fixed"
		>
			<!-- SIN OVERLAY DE OSCURECIMIENTO - Video 100% nítido y libre de capas oscuras -->
			<div
				class="absolute inset-0 bg-linear-to-t from-black/40 via-black/20 to-black/30 z-[1] pointer-events-none"
			>
			</div>
			<!-- Textos principales del Hero Corporativo -->
			<div
				id="hero-description"
				class="absolute inset-0 z-10 flex flex-col items-center justify-center text-center px-6 pointer-events-none"
			>
				<!-- Badge Superior Corporativo -->
				<span
					class="px-5 py-1.5 rounded-full bg-white/90 backdrop-blur-md border border-sky-300 text-sky-700 text-xs md:text-sm font-bold tracking-[0.25em] uppercase mb-4 shadow-xl shadow-sky-900/10"
				>
					Pureza & Calidad Certificada
				</span>

				<!-- Título Principal Limpio -->
				<h1
					class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold text-white tracking-tight drop-shadow-[0_4px_16px_rgba(2,132,199,0.7)] my-2 font-display"
				>
					Agua Purificada Jalsuri
				</h1>

				<!-- Subtítulo Corporativo Nítido -->
				<p
					class="mt-3 text-sky-50 font-medium text-base sm:text-lg md:text-xl max-w-xl tracking-wide drop-shadow-[0_2px_10px_rgba(14,165,233,0.6)] leading-relaxed"
				>
					Agua 100% pura y purificada directo a tu hogar u
					oficina. Tecnología de filtración, ozonización y UV
					para una hidratación ligera y saludable.
				</p>

				<!-- CTAs del Hero -->
				<div
					class="mt-8 flex flex-col sm:flex-row items-center gap-4 pointer-events-auto"
				>
					<a
						href="https://wa.me/51997673300?text=Hola,%20deseo%20hacer%20un%20pedido"
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-primary text-white font-extrabold text-sm uppercase tracking-wider shadow-xl shadow-primary/40 hover:bg-secondary hover:-translate-y-1 transition-all duration-300"
					>
						Pedir por WhatsApp
					</a>
					<a
						href="#productos"
						class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-white/90 text-primary font-bold text-sm uppercase tracking-wider backdrop-blur-md border border-white/60 hover:bg-white hover:-translate-y-1 transition-all duration-300"
					>
						Ver presentaciones
					</a>
				</div>
			</div>

			<video
				id="hero-video"
				src={VideoKey}
				class="w-full h-full object-cover"
				muted
				playsinline
				preload="auto"
			>
				Tu navegador no admite el elemento <code>video</code>.
			</video>
		</picture>

		<section
			id="compromiso"
			class="absolute bottom-20 w-full py-20 lg:py-32 overflow-hidden opacity-0"
		>
			<div class="relative max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 z-10">
