---
import Layout from "../layouts/Layout.astro";
import VideoKey from "@/assets/video-optimizado.mp4";
import imgKey from "@/assets/logo.webp";
import ChevronDown from "@/components/icons/ChevronDown.astro";

// Images from src/assets/img/
import imgBidon20L from "@/assets/img/20LT-OKAS.webp";
import imgMaquila from "@/assets/img/AGUA-MAQUILA.webp";
import imgPortadaBidon from "@/assets/img/PORTADA-WEB-JALSURI-BIDON-8.5-LITROS_2.webp";
import imgDispensador from "@/assets/img/Dispensador-Jalsuri-1024x867.webp";
import imgRack from "@/assets/img/Rack-para-bidondes2-1024x867-removebg-preview.webp";
---

<Layout>
	<!-- HEADER CORPORATIVO FIJO -->
	<header
		id="main-header"
		class="fixed top-0 left-0 w-full z-50 px-4 sm:px-8 lg:px-12 py-3.5 transition-all duration-300 pointer-events-auto backdrop-blur-xl shadow-sm shadow-sky-900/5"
	>
		<div class="max-w-7xl mx-auto flex justify-between items-center text-sky-100">
			<!-- Logo + Brand Name -->
			<a
				href="#hero-container"
				class="flex items-center gap-3 group focus:outline-none"
			>
				<div
					class="p-1 rounded-xl bg-sky-50 border border-sky-200/80 transition-transform group-hover:scale-105"
				>
					<img
						src={imgKey.src}
						alt="Jalsuri Logo"
						class="h-9 w-auto object-contain"
					/>
				</div>
				<div class="flex flex-col">
					<span
						class="text-slate-900 font-extrabold text-lg tracking-tight font-display leading-tight group-hover:text-sky-600 transition-colors"
					>
						JALSURI
					</span>
					<span
						class="text-[10px] tracking-widest uppercase font-semibold text-sky-500"
					>
						Agua Purificada
					</span>
				</div>
			</a>

			<!-- Navigation Menu (Desktop) -->
			<nav
				class="hidden md:flex items-center gap-8 text-sm font-medium"
			>
				<a
					href="#hero-container"
					class="hover:text-sky-600 transition-colors py-1 relative group"
				>
					Inicio
					<span
						class="absolute bottom-0 left-0 w-0 h-0.5 bg-sky-500 transition-all duration-300 group-hover:w-full"
					></span>
				</a>
				<a
					href="#compromiso"
					class="hover:text-sky-600 transition-colors py-1 relative group"
				>
					Nosotros
					<span
						class="absolute bottom-0 left-0 w-0 h-0.5 bg-sky-500 transition-all duration-300 group-hover:w-full"
					></span>
				</a>
				<a
					href="#productos"
					class="hover:text-sky-600 transition-colors py-1 relative group"
				>
					Productos
					<span
						class="absolute bottom-0 left-0 w-0 h-0.5 bg-sky-500 transition-all duration-300 group-hover:w-full"
					></span>
				</a>
				<a
					href="#maquila"
					class="hover:text-sky-600 transition-colors py-1 relative group"
				>
					Maquila & Empresas
					<span
						class="absolute bottom-0 left-0 w-0 h-0.5 bg-sky-500 transition-all duration-300 group-hover:w-full"
					></span>
				</a>
				<a
					href="#contacto"
					class="hover:text-sky-600 transition-colors py-1 relative group"
				>
					Contacto
					<span
						class="absolute bottom-0 left-0 w-0 h-0.5 bg-sky-500 transition-all duration-300 group-hover:w-full"
					></span>
				</a>
			</nav>

			<!-- Right CTA Button & Mobile Toggle -->
			<div class="flex items-center gap-4">
				<a
					href="https://wa.me/51997673300"
					target="_blank"
					rel="noopener noreferrer"
					class="hidden sm:inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-gradient-to-r from-sky-500 via-sky-600 to-blue-700 hover:from-sky-400 hover:to-blue-800 text-white font-semibold text-xs tracking-wider uppercase shadow-lg shadow-sky-500/25 transition-all duration-300 hover:scale-[1.03] active:scale-[0.98]"
				>
					<svg
						class="w-4 h-4"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
						xmlns="http://www.w3.org/2000/svg"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
						></path>
					</svg>
					Cotizar Ahora
				</a>

				<!-- Mobile Menu Toggle Button -->
				<button
					id="mobile-menu-btn"
					aria-label="Toggle Navigation Menu"
					class="md:hidden p-2 rounded-xl text-slate-700 hover:text-sky-600 hover:bg-sky-50 focus:outline-none transition-colors"
				>
					<svg
						id="menu-icon-open"
						class="w-6 h-6"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
					<svg
						id="menu-icon-close"
						class="w-6 h-6 hidden"
						fill="none"
						stroke="currentColor"
						viewBox="0 0 24 24"
					>
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
			</div>
		</div>

		<!-- Mobile Navigation Drawer -->
		<div
			id="mobile-menu"
			class="hidden md:hidden mt-3 pt-4 border-t border-sky-100 flex flex-col gap-3 pb-2 text-slate-700 font-medium text-sm animate-fadeIn"
		>
			<a
				href="#hero-container"
				class="px-3 py-2 rounded-lg hover:bg-sky-50 hover:text-sky-600 transition-colors"
				>Inicio</a
			>
			<a
				href="#compromiso"
				class="px-3 py-2 rounded-lg hover:bg-sky-50 hover:text-sky-600 transition-colors"
				>Nosotros</a
			>
			<a
				href="#productos"
				class="px-3 py-2 rounded-lg hover:bg-sky-50 hover:text-sky-600 transition-colors"
				>Productos</a
			>
			<a
				href="#maquila"
				class="px-3 py-2 rounded-lg hover:bg-sky-50 hover:text-sky-600 transition-colors"
				>Maquila & Empresas</a
			>
			<a
				href="#contacto"
				class="px-3 py-2 rounded-lg hover:bg-sky-50 hover:text-sky-600 transition-colors"
				>Contacto</a
			>
			<a
				href="https://wa.me/51997673300"
				target="_blank"
				rel="noopener noreferrer"
				class="mt-2 text-center py-2.5 rounded-full bg-gradient-to-r from-sky-500 to-blue-600 text-white font-semibold text-xs uppercase tracking-wider shadow-md"
			>
				Cotizar Vía WhatsApp
			</a>
		</div>
	</header>

	<!-- 1. HERO SECTION CON MÁSCARA Y VIDEO (SIN OVERLAY) -->
	<section
		id="hero-container"
		class="relative w-full h-screen overflow-hidden bg-slate-950"
	>
		<!-- Máscara con el logo y el video de fondo -->
		<div
			id="logo-mask"
			class="w-full h-full absolute top-0 left-0 bg-white shadow-[0px_100px_32px_0px_rgba(207,207,207,0.2)]"
			style={`--mask-url: url('${imgKey.src}');`}
		>
			<picture
				id="hero-key"
				class="h-screen w-screen block overflow-hidden fixed"
			>
				<!-- SIN OVERLAY DE OSCURECIMIENTO - Video 100% nítido y libre de capas oscuras -->
				<div
					class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/60 z-[1] pointer-events-none"
				>
				</div>
				<!-- Textos principales del Hero Corporativo -->
				<div
					id="hero-description"
					class="absolute inset-0 z-10 flex flex-col items-center justify-center text-center px-6 pointer-events-none"
				>
					<!-- Badge Superior Corporativo -->
					<span
						class="px-5 py-1.5 rounded-full bg-white/90 backdrop-blur-md border border-sky-300 text-sky-700 text-xs md:text-sm font-bold tracking-[0.25em] uppercase mb-4 shadow-xl shadow-sky-900/10"
					>
						💧 Pureza & Calidad Certificada
					</span>

					<!-- Título Principal Limpio -->
					<h1
						class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold text-white tracking-tight drop-shadow-[0_4px_16px_rgba(2,132,199,0.7)] my-2 font-display"
					>
						Agua Purificada Jalsuri
					</h1>

					<!-- Subtítulo Corporativo Nítido -->
					<p
						class="mt-3 text-sky-50 font-medium text-base sm:text-lg md:text-xl max-w-xl tracking-wide drop-shadow-[0_2px_10px_rgba(14,165,233,0.6)] leading-relaxed"
					>
						Tecnología de microfiltración y ozonización para una
						hidratación pura, ligera y saludable.
					</p>

					<!-- Action Buttons inside Hero -->
					<div
						class="mt-8 flex flex-wrap items-center justify-center gap-4 pointer-events-auto"
					>
						<a
							href="#productos"
							class="px-7 py-3 rounded-full bg-sky-500 hover:bg-sky-400 text-white font-bold text-xs sm:text-sm tracking-wider uppercase shadow-lg shadow-sky-500/30 transition-all hover:scale-105"
						>
							Explorar Productos
						</a>
						<a
							href="#maquila"
							class="px-7 py-3 rounded-full bg-white/90 hover:bg-white text-slate-900 font-bold text-xs sm:text-sm tracking-wider uppercase shadow-lg shadow-black/10 transition-all hover:scale-105"
						>
							Servicio Maquila
						</a>
					</div>
				</div>

				<video
					id="hero-video"
					src={VideoKey}
					class="w-full h-full object-cover"
					muted
					playsinline
					preload="auto"
				>
					Tu navegador no admite el elemento <code>video</code>.
				</video>
			</picture>
		</div>
		<div id="hero-subtitle"
			class="fixed bottom-6 left-0 right-0 z-20 text-white opacity-0"
		>
			Brindamos el mejor servicio de calidad y pureza en agua purificada |
			Envasado de bebidas para empresas
		</div>

		<!-- Indicador Inferior de Scroll -->
		<div
			class="fixed bottom-6 left-0 right-0 z-20 flex flex-col items-center justify-end pointer-events-none"
		>
			<div
				class="flex flex-col items-center gap-1.5 px-4 py-2"
			>
				<span
					class="text-[10px] tracking-[0.3em] uppercase text-sky-200 font-bold drop-shadow-[0_0_8px_rgba(56,189,248,0.8)]"
				>
					Desliza para explorar
				</span>
				<ChevronDown
					class="h-auto w-10 text-sky-400 animate-bounce drop-shadow-[0_0_8px_rgba(56,189,248,0.9)]"
				/>
			</div>
		</div>
	</section>

	<!-- 2. SECCIÓN: COMPROMISO Y CALIDAD JALSURI -->
	<section
		id="compromiso"
		class="relative z-30 bg-gradient-to-b from-slate-950 via-slate-900 to-sky-950 text-slate-100 py-28 px-6 md:px-12 overflow-hidden border-t border-sky-500/20"
	>
		<!-- Resplandor Ambiental en Tonos Celeste, Azul e Ice -->
		<div
			class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] bg-gradient-to-tr from-sky-600/20 via-blue-700/20 to-cyan-400/15 rounded-full blur-3xl pointer-events-none"
		>
		</div>

		<div class="relative max-w-6xl mx-auto space-y-16">
			<!-- Header de Sección -->
			<div class="text-center max-w-3xl mx-auto space-y-4">
				<div
					class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sky-950/80 border border-sky-400/40 text-xs font-semibold tracking-[0.25em] uppercase shadow-md shadow-sky-900/30"
				>
					<span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"
					></span>
					<span
						class="bg-gradient-to-r from-sky-200 via-cyan-200 to-white bg-clip-text text-transparent"
					>
						Calidad Garantizada
					</span>
				</div>

				<h2
					class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-display"
				>
					Pureza Excepcional para Tu Estilo de Vida
				</h2>
				<p
					class="text-sky-200/80 font-normal text-base sm:text-lg leading-relaxed"
				>
					En Jalsuri combinamos los estándares más estrictos de
					purificación con tecnología ozonizada de última generación
					para entregar agua 100% limpia, liviana y confiable.
				</p>
			</div>

			<!-- Tarjeta Principal Corporativa -->
			<div
				class="relative bg-slate-900/80 backdrop-blur-2xl border border-sky-300/20 rounded-3xl p-8 md:p-14 shadow-2xl shadow-slate-950/80 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center"
			>
				<div class="lg:col-span-7 space-y-6">
					<span
						class="text-sky-400 text-xs font-bold tracking-[0.3em] uppercase block"
					>
						Proceso Certificado
					</span>
					<h3
						class="text-2xl sm:text-4xl font-bold text-white font-display leading-tight"
					>
						Sistema de Triple Ozonización & Microfiltración
					</h3>
					<p
						class="text-slate-300 font-light text-base leading-relaxed"
					>
						Nuestras plantas cuentan con procesos automatizados de
						llenado y envasado en ambientes esterilizados.
						Garantizamos que cada gota mantenga su frescura natural
						y equilibrio mineral.
					</p>

					<div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4">
						<div
							class="p-4 rounded-2xl bg-slate-800/60 border border-sky-400/15 flex items-start gap-3"
						>
							<div
								class="p-2 rounded-xl bg-sky-500/20 text-sky-400 shrink-0"
							>
								<svg
									class="w-5 h-5"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
									><path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M5 13l4 4L19 7"></path></svg
								>
							</div>
							<div>
								<h4 class="text-white font-semibold text-sm">
									Libre de Sodio
								</h4>
								<p class="text-xs text-slate-400 mt-0.5">
									Ideal para una hidratación saludable diaria.
								</p>
							</div>
						</div>

						<div
							class="p-4 rounded-2xl bg-slate-800/60 border border-sky-400/15 flex items-start gap-3"
						>
							<div
								class="p-2 rounded-xl bg-sky-500/20 text-sky-400 shrink-0"
							>
								<svg
									class="w-5 h-5"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
									><path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
									></path></svg
								>
							</div>
							<div>
								<h4 class="text-white font-semibold text-sm">
									Registro DIGESA
								</h4>
								<p class="text-xs text-slate-400 mt-0.5">
									Cumplimiento total de normas sanitarias.
								</p>
							</div>
						</div>
					</div>
				</div>

				<div class="lg:col-span-5 relative flex justify-center">
					<div
						class="relative w-full max-w-xs aspect-square rounded-2xl overflow-hidden border border-sky-300/30 p-2 bg-gradient-to-b from-sky-500/20 to-blue-900/40 shadow-2xl"
					>
						<img
							src={imgPortadaBidon.src}
							alt="Bidon Jalsuri 8.5L y 20L"
							class="w-full h-full object-contain rounded-xl transition-transform duration-700 hover:scale-105"
						/>
					</div>
				</div>
			</div>

			<!-- 4 Métricas Clave Corporativas -->
			<div class="grid grid-cols-2 md:grid-cols-4 gap-6">
				<div
					class="bg-slate-900/60 backdrop-blur-md p-6 rounded-2xl border border-sky-400/20 text-center space-y-2"
				>
					<div
						class="text-3xl sm:text-4xl font-extrabold text-sky-400 font-display"
					>
						99.9%
					</div>
					<div
						class="text-xs text-sky-100/80 uppercase font-semibold tracking-wider"
					>
						Pureza Ozonizada
					</div>
				</div>
				<div
					class="bg-slate-900/60 backdrop-blur-md p-6 rounded-2xl border border-sky-400/20 text-center space-y-2"
				>
					<div
						class="text-3xl sm:text-4xl font-extrabold text-sky-400 font-display"
					>
						7
					</div>
					<div
						class="text-xs text-sky-100/80 uppercase font-semibold tracking-wider"
					>
						Etapas Filtración
					</div>
				</div>
				<div
					class="bg-slate-900/60 backdrop-blur-md p-6 rounded-2xl border border-sky-400/20 text-center space-y-2"
				>
					<div
						class="text-3xl sm:text-4xl font-extrabold text-sky-400 font-display"
					>
						+500
					</div>
					<div
						class="text-xs text-sky-100/80 uppercase font-semibold tracking-wider"
					>
						Clientes Empresas
					</div>
				</div>
				<div
					class="bg-slate-900/60 backdrop-blur-md p-6 rounded-2xl border border-sky-400/20 text-center space-y-2"
				>
					<div
						class="text-3xl sm:text-4xl font-extrabold text-sky-400 font-display"
					>
						24/7
					</div>
					<div
						class="text-xs text-sky-100/80 uppercase font-semibold tracking-wider"
					>
						Despacho Continuo
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- 3. CATÁLOGO CORPORATIVO DE PRODUCTOS -->
	<section
		id="productos"
		class="relative z-30 bg-slate-50 text-slate-900 py-28 px-6 md:px-16"
	>
		<div class="max-w-7xl mx-auto space-y-16">
			<div class="text-center space-y-3">
				<span
					class="text-sky-600 text-xs font-bold tracking-[0.3em] uppercase bg-sky-100 px-4 py-1.5 rounded-full inline-block"
				>
					Línea Completa
				</span>
				<h3
					class="text-3xl sm:text-5xl font-extrabold text-slate-900 font-display"
				>
					Productos & Soluciones Jalsuri
				</h3>
				<p class="text-slate-600 max-w-2xl mx-auto text-base">
					Disponemos de formatos adaptados a las necesidades de
					hogares, oficinas, instituciones y eventos corporativos.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				<!-- Producto 1: Bidones de 20L -->
				<article
					class="group bg-white p-6 rounded-3xl border border-slate-200/80 shadow-lg shadow-sky-950/5 hover:border-sky-400 hover:shadow-2xl hover:shadow-sky-500/15 transition-all duration-500 flex flex-col justify-between"
				>
					<div>
						<div
							class="relative overflow-hidden aspect-square bg-sky-50 rounded-2xl p-4 flex items-center justify-center"
						>
							<img
								src={imgBidon20L.src}
								alt="Bidón Jalsuri 20 Litros"
								class="w-full h-full object-contain transition-transform duration-700 ease-out group-hover:scale-105"
							/>
							<span
								class="absolute top-3 right-3 bg-sky-500 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider"
							>
								Popular
							</span>
						</div>
						<div class="pt-6 space-y-2">
							<h4
								class="text-xl font-bold text-slate-900 font-display group-hover:text-sky-600 transition-colors"
							>
								Bidones de 20 Litros
							</h4>
							<p class="text-xs text-slate-600 leading-relaxed">
								Bidones ergonómicos con caño o para dispensador.
								Agua 100% purificada y tratada con ozono.
							</p>
						</div>
					</div>

					<div
						class="pt-6 border-t border-slate-100 mt-6 flex items-center justify-between"
					>
						<span class="text-xs font-semibold text-slate-500"
							>Hogar & Oficina</span
						>
						<a
							href="https://wa.me/51997673300?text=Hola,%20deseo%20informaci%C3%B3n%20sobre%20los%20bidones%20de%2020L"
							target="_blank"
							rel="noopener noreferrer"
							class="px-4 py-2 rounded-full bg-sky-50 group-hover:bg-sky-500 text-sky-600 group-hover:text-white font-semibold text-xs transition-colors"
						>
							Pedir Ahora →
						</a>
					</div>
				</article>

				<!-- Producto 2: Maquila & Botellas Personalizadas -->
				<article
					class="group bg-white p-6 rounded-3xl border border-slate-200/80 shadow-lg shadow-sky-950/5 hover:border-sky-400 hover:shadow-2xl hover:shadow-sky-500/15 transition-all duration-500 flex flex-col justify-between"
				>
					<div>
						<div
							class="relative overflow-hidden aspect-square bg-sky-50 rounded-2xl p-4 flex items-center justify-center"
						>
							<img
								src={imgMaquila.src}
								alt="Servicio de Maquila de Agua Personalizada"
								class="w-full h-full object-contain transition-transform duration-700 ease-out group-hover:scale-105"
							/>
							<span
								class="absolute top-3 right-3 bg-blue-600 text-white text-[10px] font-bold px-3 py-1 rounded-full uppercase tracking-wider"
							>
								Empresas
							</span>
